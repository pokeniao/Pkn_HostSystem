<UserControl x:Class="Pkn_HostSystem.MyControl.PknTimePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Pkn_HostSystem.MyControl"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- 时间选择 -->
        <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="3" Padding="5">
            <WrapPanel>
                <TextBlock Text="起始时间: " VerticalAlignment="Center" />
                <ComboBox Width="80"
                              Background="{x:Null}"
                              BorderThickness="0"
                              ItemsSource="{Binding Hours , RelativeSource={RelativeSource AncestorType=UserControl}}" 
                              SelectedItem="{Binding StartSelectedHour, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text=":" VerticalAlignment="Center" />
                <ComboBox Width="80" 
                              Background="{x:Null}"
                              BorderThickness="0"
                              ItemsSource="{Binding Minutes , RelativeSource={RelativeSource AncestorType=UserControl}}"
                              SelectedItem="{Binding StartSelectedMinute, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="到 " VerticalAlignment="Center" />
                <TextBlock Text="截止时间: " VerticalAlignment="Center" />
         
                <ComboBox Width="80"
                              Background="{x:Null}"
                              BorderThickness="0"
                              ItemsSource="{Binding Hours, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                              SelectedItem="{Binding EndSelectedHour, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text=":" VerticalAlignment="Center" />
                <ComboBox Width="80" 
                              Background="{x:Null}"
                              BorderThickness="0"
                              ItemsSource="{Binding Minutes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              SelectedItem="{Binding EndSelectedMinute, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}" />
            </WrapPanel>
        </Border>
    </Grid>
</UserControl>
