<Page x:Class="Pkn_HostSystem.Views.Pages.DesignPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:page="clr-namespace:Pkn_HostSystem.ViewModels.Page"
      xmlns:ha="http://schemas.mvtec.com/halcondotnet"
      mc:Ignorable="d"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"

      d:DataContext="{d:DesignInstance page:DesignViewModel}"
      d:DesignHeight="714.5" d:DesignWidth="1000"
      Title="DesignPage">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.2*" />
            <ColumnDefinition Width="0.45*" />
            <ColumnDefinition Width="0.35*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Border
                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                Margin="10 0 0 10"
                BorderThickness="1"
                CornerRadius="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0">
                        <ui:SymbolIcon Symbol="AlignSpaceAroundHorizontal20" Margin="5" />
                        <TextBlock Text="组件" Margin="0 5 " />
                    </WrapPanel>

                    <Border Grid.Row="1" BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" />
                    <TreeView Grid.Row="2" AllowDrop="True">
                        <TreeViewItem IsExpanded="True">
                            <TreeViewItem.Header>
                                <TextBlock FontSize="12" Text="Http" />
                            </TreeViewItem.Header>

                            <TreeViewItem Header="Feature Schedule" />
                        </TreeViewItem>
                    </TreeView>
                </Grid>
            </Border>

        </Grid>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="6*" />
                <RowDefinition Height="4*" />
            </Grid.RowDefinitions>
            <Border
                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                Margin="10 0 10 10 "
                BorderThickness="1"
                CornerRadius="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0">
                        <ui:SymbolIcon Symbol="Branch20"  Margin="5"/>
                        <TextBlock Text="流程" Margin="0 5" />
                    </WrapPanel>
  
                    <Border Grid.Row="1" BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" />
                </Grid>
            </Border>
            <Border
                Grid.Row="1"
                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                Margin="10  0 10 10"
                BorderThickness="1"
                CornerRadius="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0">
                        <ui:SymbolIcon Symbol="Alert16" Margin="5"/>
                        <TextBlock  Text="Log"  Margin="0 5"/>
                    </WrapPanel>
                  
                    <Border Grid.Row="1" BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" />

                    <RichTextBox
                        Grid.Row="2" BorderThickness="0"
                        Name="LogRichTextBox"
                        IsReadOnly="True"
                        Background="{ui:ThemeResource CardStrokeColorDefaultSolidBrush}"
                        VerticalScrollBarVisibility="Auto"
                        FontSize="12">
                    </RichTextBox>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.4*" />
                <RowDefinition Height="0.6*" />
            </Grid.RowDefinitions>
            <Border
                Grid.Row="0"
                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                Margin="0 0 10 0"
                BorderThickness="1"
                CornerRadius="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Camera24" Margin="5" FontSize="16" />
                        <TextBlock Grid.Column="1" Text="视觉" Margin="0 5 0 5" />


                        <ComboBox Grid.Column="2"
                                  Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  ItemsSource="{Binding CameraShowMethodList}"
                                  SelectedValue="{Binding HalconControl.CameraShowSize}"
                                  SelectedValuePath="Value"
                                  Width="100"
                                  Padding="10,5 0 0"
                                  Margin="5  0"
                                  HorizontalAlignment="Right">
                            <!-- 下拉列表里的字体 -->
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}" FontSize="10" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Border Grid.Row="1" BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" />
                    <ha:HSmartWindowControlWPF
                        Grid.Row="2"
                        Name="HSmartWindowControlWPF" />
                </Grid>

            </Border>
            <Border
                Grid.Row="1"
                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                Margin="0   10 10 10"
                BorderThickness="1"
                CornerRadius="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel  Grid.Row="0" >
                        <ui:SymbolIcon Symbol="CalendarAgenda20" Margin="5"/>
                        <TextBlock Text="参数" Margin="0 5" />
                    </WrapPanel>
           
                    <Border Grid.Row="1" BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" />
                </Grid>
            </Border>
        </Grid>
        <ui:SnackbarPresenter Name="SnackbarPresenter" />
    </Grid>
</Page>