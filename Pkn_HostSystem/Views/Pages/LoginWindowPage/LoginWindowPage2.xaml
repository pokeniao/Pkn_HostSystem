<Page x:Class="Pkn_HostSystem.Views.Pages.LoginWindowPage.LoginWindowPage2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:windows="clr-namespace:Pkn_HostSystem.ViewModels.Windows"
      mc:Ignorable="d"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"

      d:DataContext="{d:DesignInstance windows:Login2ViewModel}"
      d:DesignHeight="714.5" d:DesignWidth="1000"
      Title="LoginWindowPage2">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ui:TitleBar
            Title="账号登入"
            FontSize="15"
            Grid.ColumnSpan="2" VerticalAlignment="Center">
        </ui:TitleBar>
        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock  Grid.Row="0" Text="{Binding LoginModel.SwipResult}"
                        Margin="0 0  0 10"/>
            <Button
                Grid.Row="1"
                IsDefault="False"
                Padding="30"
                Margin="0 0 0 40"
                PreviewKeyDown="Button_PreviewKeyDown"
                Command="{Binding SwipingCardLoginButtonCommand }">
                <Button.Content>
                    <TextBlock  Text="{Binding LoginModel.SwipingCardLogin }" FontSize="40"/>
                </Button.Content>
            </Button>
        </Grid>

        <ui:SnackbarPresenter Name="SnackbarPresenter" />
    </Grid>
</Page>
    