<Page x:Class="Pkn_HostSystem.Views.Pages.StationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Pkn_HostSystem.Views.Pages"
      xmlns:page="clr-namespace:Pkn_HostSystem.ViewModels.Page"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:s="clr-namespace:Pkn_HostSystem.Static"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance page:StationViewModel}"
      d:DesignHeight="714.5" d:DesignWidth="1000"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="StationPage">


    <Grid>
     <Grid.RowDefinitions>
         <RowDefinition Height="*"/>
         <RowDefinition Height="0.5*"/>

     </Grid.RowDefinitions>
            <TabControl Name="LogTabControl" Grid.Row="0" ItemsSource="{Binding StationModel.Stations}" SelectionChanged="LogTabControl_OnSelectionChanged">
            <TabControl.ItemTemplate>
                <!-- Tab 页签标题 -->
                <DataTemplate>
                    <TextBlock Text="{Binding Header}" />
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <!-- Tab 页签内容 -->
                <DataTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DataGrid Name="LogDataGrid"  Grid.Row="0" ItemsSource="{Binding Items}" HorizontalScrollBarVisibility="Visible"  AutoGenerateColumns="True" CanUserAddRows ="False" MaxHeight="400" IsReadOnly="True"/>
                    </Grid>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <TabControl Grid.Row="1" MaxHeight="300" Name="TabControl2">
            <TabItem Header="生产参数">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition  Width="*"/>
                        <ColumnDefinition  Width="0.2*"/>
                        <ColumnDefinition  Width="*"/>
                        <ColumnDefinition  Width="Auto"/>
                        <ColumnDefinition  Width="0.2*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="良率" Margin="10" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Source={x:Static s:StaticArrayRegister.ArrayRegister}, Path=[2], StringFormat={}{0}%}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="入料数量" Margin="10"/>
                   <!-- <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding VocStations[0].EntryCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/> -->
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Source={x:Static s:StaticArrayRegister.ArrayRegister}, Path=[3], StringFormat={}{0}}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="良品数量" Margin="10"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Source={x:Static s:StaticArrayRegister.ArrayRegister}, Path=[4], StringFormat={}{0}}" VerticalAlignment="Center" />
                    
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="不良品数量" Margin="10"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Source={x:Static s:StaticArrayRegister.ArrayRegister}, Path=[5], StringFormat={}{0}}" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="运行时间" Margin="10"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Source={x:Static s:StaticArrayRegister.ArrayRegister}, Path=[6], StringFormat={}{0}h:}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding Source={x:Static s:StaticArrayRegister.ArrayRegister}, Path=[7], StringFormat={}{0}min}" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="停机时间" Margin="10"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Source={x:Static s:StaticArrayRegister.ArrayRegister}, Path=[8], StringFormat={}{0}h:}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding Source={x:Static s:StaticArrayRegister.ArrayRegister}, Path=[9], StringFormat={}{0}min}" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="2" Grid.Column="2" Text="报警时间" Margin="10"/>
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Source={x:Static s:StaticArrayRegister.ArrayRegister}, Path=[10], StringFormat={}{0}h:}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding Source={x:Static s:StaticArrayRegister.ArrayRegister}, Path=[11], StringFormat={}{0}min}" VerticalAlignment="Center" />
                </Grid>
                
            </TabItem>
            <TabItem Header="用户日志">
                <RichTextBox
                    Name="UserRichTextBox"
                    IsReadOnly="True"
                    VerticalScrollBarVisibility="Auto"
                    Loaded="UserLogRichTextBox_Loaded"
                    FontSize="12"
                >
                    <RichTextBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="滑动到底部" Click="ScrollDown_OnClick"/>
                            <MenuItem Header="清空日志" Click="ClearLog_OnClick"/>
                        </ContextMenu>
                    </RichTextBox.ContextMenu>
                </RichTextBox>
            </TabItem>
            <TabItem Header="错误日志">
                <RichTextBox
                    Name="ErrorRichTextBox"
                    Loaded="ErrorRichTextBox_OnLoaded"
                    IsReadOnly="True"
                    VerticalScrollBarVisibility="Auto"
                    FontFamily="Consolas"
                    FontSize="12"
                    BorderThickness="0">
                    <RichTextBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="滑动到底部" Click="ScrollDown_OnClick"/>
                            <MenuItem Header="清空日志" Click="ClearLog_OnClick"/>
                        </ContextMenu>
                    </RichTextBox.ContextMenu>
                </RichTextBox>

            </TabItem>
            <TabItem Header="开发者日志">
                <RichTextBox
                    Name="DevRichTextBox"
                    Loaded="DevRichTextBox_OnLoaded"
                    IsReadOnly="True"
                    VerticalScrollBarVisibility="Auto"
                    FontFamily="Consolas"
                    FontSize="12"
                    BorderThickness="0">
                    <RichTextBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="滑动到底部" Click="ScrollDown_OnClick"/>
                            <MenuItem Header="清空日志" Click="ClearLog_OnClick"/>
                        </ContextMenu>
                    </RichTextBox.ContextMenu>
                </RichTextBox>

            </TabItem>
        </TabControl>
        <ui:SnackbarPresenter Grid.Row="1" Name="SnackbarPresenter" />
    </Grid>
</Page>