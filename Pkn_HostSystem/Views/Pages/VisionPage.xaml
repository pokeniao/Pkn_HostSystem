<Page x:Class="Pkn_HostSystem.Views.Pages.VisionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:page="clr-namespace:Pkn_HostSystem.ViewModels.Page"
      xmlns:halcon="clr-namespace:HalconDotNet;assembly=halcondotnet"
      mc:Ignorable="d"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      d:DataContext="{d:DesignInstance page:VisionPageViewModel}"
      d:DesignHeight="714.5" d:DesignWidth="1000"
      Title="VisionPageViewModel">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <WrapPanel Grid.Row="0">
                <TextBlock Text="视觉显示" Margin="10,5"  TextAlignment="Center"/>
                <ComboBox ItemsSource="{Binding CameraShowMethodList }" 

                          DisplayMemberPath="Display"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding HalconControl.CameraShowSize}"
                          Width="120"/>
            </WrapPanel>
            <Border Grid.Row="1">
                <halcon:HSmartWindowControlWPF
                    Margin="5"
                    Name="HalconControl" />
            </Border>
        </Grid>
        <!-- <Button -->
        <!--     Grid.Row="2" -->
        <!--     Content="运行"  Command="{Binding RunTestCommand}"/> -->
        <ui:SnackbarPresenter Grid.Row="1" Grid.ColumnSpan="2" Name="SnackbarPresenter" />
    </Grid>

</Page>