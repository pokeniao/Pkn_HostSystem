                    <StackPanel
                        Visibility="{Binding MesTcpModel.ShowSwitchSet ,Converter={StaticResource BooleanVisibilityConverter}}">
                        <GroupBox BorderThickness="0">
                            <GroupBox.Header>
                                <WrapPanel>
                                    <TextBlock Text="{Binding MesTcpModel.SetSwitchSetName}" Margin="5" />
                                    <ui:SymbolIcon Symbol="ChatWarning20"
                                                   ToolTip="Case:为返回原内容,Value:为替换后内容,替换后进行嵌入 , Case中写入default为默认值" />
                                </WrapPanel>
                            </GroupBox.Header>
                            <DataGrid
                                HorizontalAlignment="Center"
                                Name="DynSwitchDataGrid"
                                Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                Height="150"
                                MinWidth="300"
                                ItemsSource="{Binding MesTcpModel.SwitchList}"
                                AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Case" Width="*" Binding="{Binding Case}" />
                                    <DataGridTextColumn Header="Value" Width="*" Binding="{Binding Value}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                        <WrapPanel HorizontalAlignment="Right">
                            <Button Content="删除" Click="DeleteClick" />
                            <Button Content="关闭" Margin="20,0,5,0" Click="ButtonBase_OnClick2" />
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel
                        Visibility="{Binding MesTcpModel.VeritySet ,Converter={StaticResource BooleanVisibilityConverter}}">
                        <GroupBox BorderThickness="0">
                            <GroupBox.Header>
                                <WrapPanel>
                                    <TextBlock Text="{Binding MesTcpModel.SetVeritySetName}" Margin="5" />
                                    <ui:SymbolIcon Symbol="ChatWarning20" ToolTip="Name:方便确认, Type:为校验类型, Value:填要校验的值" />
                                </WrapPanel>
                            </GroupBox.Header>
                            <DataGrid
                                HorizontalAlignment="Center"
                                Name="DynVerifyDataGrid"
                                Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                Height="150"
                                MinWidth="300"
                                ItemsSource="{Binding MesTcpModel.VerifyList}"
                                AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="备注" Width="*" Binding="{Binding Name}" />
                                    <DataGridTemplateColumn Header="类型" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <TextBlock Text="{Binding Type}" />
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <ComboBox
                                                        ItemsSource="{Binding viewModel.VerifyType,RelativeSource={RelativeSource AncestorType=Page}}"
                                                        SelectedValue="{Binding Type , UpdateSourceTrigger=PropertyChanged}" />
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="值" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <TextBlock Text="{Binding Value}" />
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid
                                                        Visibility="{Binding showValueTextBox , Converter={StaticResource BooleanVisibilityConverter}}">
                                                        <TextBox Text="{Binding Value}" />
                                                    </Grid>

                                                    <Grid
                                                        Visibility="{Binding showValueCombox , Converter={StaticResource BooleanVisibilityConverter}}">
                                                        <ComboBox
                                                            ItemsSource="{Binding DataContext.UserDefinedList ,RelativeSource={RelativeSource AncestorType=Page}}"
                                                            SelectedValue="{Binding ComplexValue}"
                                                            DisplayMemberPath="Name" />
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                        <WrapPanel HorizontalAlignment="Right">
                            <Button Content="删除" Click="DeleteClick2" />
                            <Button Content="关闭" Margin="20,0,5,0" Click="ButtonBase_OnClick3" />
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel
                        Visibility="{Binding MesTcpModel.HttpSet ,Converter={StaticResource BooleanVisibilityConverter}}">
                        <GroupBox BorderThickness="0">
                            <GroupBox.Header>
                                <WrapPanel>
                                    <TextBlock Text="{Binding MesTcpModel.SetHttpObjectName}" Margin="5" />
                                    <ui:SymbolIcon Symbol="ChatWarning20"
                                                   ToolTip="" />
                                </WrapPanel>
                            </GroupBox.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.5*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <GroupBox Grid.Column="0" BorderThickness="0" Header="返回内容嵌入">
                                    <TextBox
                                        Style="{x:Null}"
                                        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        MinWidth="150"
                                        BorderThickness="0"
                                        Height="150"
                                        Text="{Binding MesTcpModel.InteriorReturnMessage.Value  ,UpdateSourceTrigger= PropertyChanged ,Mode=TwoWay}"
                                        TextWrapping="Wrap"
                                        AcceptsReturn="True"
                                        HorizontalScrollBarVisibility="Auto"
                                        VerticalScrollBarVisibility="Auto" />
                                </GroupBox>
                                <GroupBox Grid.Column="1" BorderThickness="0" Header="解析内容">
                                    <DataGrid
                                        Name="DynHttpDataGrid"
                                        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                        Height="150"
                                        MinWidth="150"
                                        ItemsSource="{Binding MesTcpModel.HttpObjects}"
                                        AutoGenerateColumns="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="嵌入名" Width="0.5*" Binding="{Binding Name}" />
                                            <DataGridTemplateColumn Header="方法" Width="0.5*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <TextBlock Text="{Binding Method}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <ComboBox
                                                                SelectedValue="{Binding Method ,UpdateSourceTrigger=PropertyChanged}"
                                                                ItemsSource="{Binding viewModel.InteriorMethod  ,RelativeSource={RelativeSource  AncestorType=Page}}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn
                                                Header="参数" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <TextBlock Text="{Binding ParamShow }" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid
                                                                Visibility="{Binding showMethod1 ,Converter={StaticResource BooleanVisibilityConverter}}">
                                                                <TextBox
                                                                    Text="{Binding staticParam , UpdateSourceTrigger=PropertyChanged}" />
                                                            </Grid>
                                                            <Grid
                                                                Visibility="{Binding showMethod2 ,Converter={StaticResource BooleanVisibilityConverter}}">
                                                                <TextBox
                                                                    Text="{Binding JsonParam , UpdateSourceTrigger=PropertyChanged}" />
                                                            </Grid>
                                                            <Grid
                                                                Visibility="{Binding showMethod3 ,Converter={StaticResource BooleanVisibilityConverter}}">
                                                                <TextBlock Text="{Binding ParamMethods}" />
                                                            </Grid>
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </GroupBox>
                            </Grid>
                        </GroupBox>
                        <WrapPanel HorizontalAlignment="Right">
                            <Button Content="删除" />
                            <Button Content="关闭" Margin="20,0,5,0" Click="ButtonBase_OnClick4" />
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel
                        Visibility="{Binding MesTcpModel.TranspondSet,Converter={StaticResource BooleanVisibilityConverter}}">
                        <GroupBox Header="{Binding MesTcpModel.TranspondSetName}" BorderThickness="1"
                                  Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}">
                            <StackPanel>
                                <WrapPanel Margin="0,10,0,0">
                                    <TextBlock Text="转发方式" Margin="5" VerticalAlignment="Center" />
                                    <ComboBox ItemsSource="{Binding ForwardingMethod}"
                                              SelectedValue="{Binding MesTcpModel.TranspondModbusDetailed.TranspondMethod}" />
                                </WrapPanel>
                                <TabControl Margin="0,10,0,0" MinWidth="300">
                                    <TabItem>
                                        <TabItem.Header>
                                            <TextBlock Text="通讯方式" />
                                        </TabItem.Header>
                                        <Grid>
                                            <StackPanel>
                                                <WrapPanel Margin="0,10,0,0">
                                                    <TextBlock Text="通讯对象" Margin="5" VerticalAlignment="Center" />
                                                    <ComboBox
                                                        Width="100"
                                                        ItemsSource="{Binding MesTcpModel.NetWorkList}"
                                                        DisplayMemberPath="NetworkDetailed.Name"
                                                        SelectedValuePath="NetworkDetailed.Name"
                                                        SelectedValue="{Binding MesTcpModel.TranspondModbusDetailed.ConnectName}" />
                                                </WrapPanel>
                                                <WrapPanel Margin="0,10,0,0">
                                                    <TextBlock Text="站地址" Margin="5" VerticalAlignment="Center" />
                                                    <ui:NumberBox
                                                        Width="200"
                                                        Minimum="1"
                                                        Value="{Binding MesTcpModel.TranspondModbusDetailed.SlaveAddress,UpdateSourceTrigger=PropertyChanged}" />
                                                </WrapPanel>
                                                <WrapPanel Margin="0,10,0,0">
                                                    <TextBlock Text="起始地址" Margin="5" VerticalAlignment="Center" />
                                                    <ui:NumberBox
                                                        Width="200"
                                                        Minimum="0"
                                                        Value="{Binding MesTcpModel.TranspondModbusDetailed.StartAddress,UpdateSourceTrigger=PropertyChanged}" />
                                                </WrapPanel>
                                                <WrapPanel Margin="0,10,0,0">
                                                    <TextBlock Text="长度" Margin="5" VerticalAlignment="Center" />
                                                    <ui:NumberBox
                                                        Width="200"
                                                        Minimum="1"
                                                        Value="{Binding MesTcpModel.TranspondModbusDetailed.Length,UpdateSourceTrigger=PropertyChanged}" />
                                                </WrapPanel>
                                                <WrapPanel Margin="0,10,0,0">
                                                    <TextBlock Text="转发后不再嵌入" Margin="5" VerticalAlignment="Center" />
                                                    <ui:ToggleSwitch OffContent="关闭" OnContent="开启"
                                                                     IsChecked="{Binding MesTcpModel.TranspondModbusDetailed.NoReturn}" />
                                                </WrapPanel>

                                                <WrapPanel HorizontalAlignment="Right">
                                                    <Button Content="关闭" Margin="20,0,5,0" Click="ButtonBase_OnClick5" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Grid>
                                    </TabItem>
                                    <TabItem>
                                        <TabItem.Header>
                                            <TextBlock Text="内部地址/队列" />
                                        </TabItem.Header>
                                        <Grid>
                                            <StackPanel>
                                                <WrapPanel Margin="0,10,0,0">
                                                    <TextBlock Text="地址" Margin="5" VerticalAlignment="Center" />
                                                    <ui:NumberBox
                                                        Width="100"
                                                        ClearButtonEnabled="False"
                                                        Minimum="0"
                                                        MaxWidth="99"
                                                        Value="{Binding MesTcpModel.TranspondModbusDetailed.InteriorAddress,UpdateSourceTrigger=PropertyChanged}" />
                                                </WrapPanel>
                                                <WrapPanel Margin="0,10,0,0">
                                                    <TextBlock Text="转发后不再嵌入" Margin="5" VerticalAlignment="Center" />
                                                    <ui:ToggleSwitch OffContent="关闭" OnContent="开启"
                                                                     IsChecked="{Binding MesTcpModel.TranspondModbusDetailed.NoReturn}" />
                                                </WrapPanel>
                                                <WrapPanel HorizontalAlignment="Right">
                                                    <Button Content="关闭" Margin="20,0,5,0" Click="ButtonBase_OnClick5" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Grid>
                                    </TabItem>
                                </TabControl>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>

                </UniformGrid>
            </Grid>
        </Grid>
        <ui:SnackbarPresenter Grid.ColumnSpan="2" Name="SnackbarPresenter" Margin="0,-5,0,4" />
    </Grid>
</Page>