<Page x:Class="Pkn_HostSystem.Views.Pages.SerialToolPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:page="clr-namespace:Pkn_HostSystem.ViewModels.Page"
      mc:Ignorable="d"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"

      d:DataContext="{d:DesignInstance page:SerialToolViewModel}"
      d:DesignHeight="714.5" d:DesignWidth="1000"
      Title="SerialToolPage"
      SizeChanged="SerialToolPage_OnSizeChanged">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <GroupBox Header="配置串口" Margin="10">
                <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.7*" />
                            <RowDefinition Height="0.3*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <WrapPanel>
                                <TextBlock Text="端口号" Margin="10" />
                                <ComboBox Width="120" ItemsSource="{Binding SerialToolModel.ComList}"
                                          SelectedValue="{Binding SerialToolModel.Com}" />
                            </WrapPanel>
                            <WrapPanel>
                                <TextBlock Text="波特率" Margin="10" />
                                <ComboBox Width="120" ItemsSource="{Binding SerialToolModel.BaudRates}"
                                          SelectedValue="{Binding SerialToolModel.BaudRate}" />
                            </WrapPanel>

                            <WrapPanel>
                                <TextBlock Text="数据位" Margin="10" />
                                <ComboBox Width="120" ItemsSource="{Binding SerialToolModel.DataBitss}"
                                          SelectedValue="{Binding SerialToolModel.DataBits}" />
                            </WrapPanel>

                            <WrapPanel>
                                <TextBlock Text="停止位" Margin="10" />
                                <ComboBox Width="120" ItemsSource="{Binding SerialToolModel.StopBitsList}"
                                          SelectedValue="{Binding SerialToolModel.StopBits}" />
                            </WrapPanel>

                            <WrapPanel>
                                <TextBlock Text="校验位" Margin="10" />
                                <ComboBox Width="120" ItemsSource="{Binding SerialToolModel.Parities}"
                                          SelectedValue="{Binding SerialToolModel.Paritie}" />
                            </WrapPanel>
                            <WrapPanel>
                                <TextBlock Text="超时时间" Margin="10" />
                                <ui:NumberBox Width="170"
                                              Value="{Binding SerialToolModel.TimeOut ,UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>
                            <WrapPanel>
                                <TextBlock Text="结束符" Margin="10" />
                                <ComboBox Width="120" ItemsSource="{Binding SerialToolModel.NewLines}"
                                          SelectedValue="{Binding SerialToolModel.NewLine}"
                                          DisplayMemberPath="Key"
                                          SelectedValuePath="Value" />
                            </WrapPanel>

                            <WrapPanel>
                                <TextBlock Text="发送并等待超时时间(可填)" Margin="10" />
                                <ui:NumberBox Width="170"
                                              Value="{Binding SerialToolModel.WriteTimeOut ,UpdateSourceTrigger=PropertyChanged}" />
                            </WrapPanel>

                        </StackPanel>
                        <StackPanel Grid.Row="1">
                            <Button Name="ConnectButton" Content="{Binding SerialToolModel.ConnectButton}"
                                    Command="{Binding ConnectCommand}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Page}}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </GroupBox>
        </Grid>
        <Grid Grid.Column="1">
            <GroupBox Header="接受发送" Margin="10">
                <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <GroupBox Grid.Row="0" Header="接收">
                                <TextBox
                                    Name="AcceptMessageTextBox"
                                    Style="{x:Null}"
                                    TextWrapping="Wrap"
                                    AcceptsReturn="True"
                                    IsReadOnly="True"
                                    BorderThickness="0"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                    Text="{Binding SerialToolModel.AcceptMessageText }" />
                            </GroupBox>
                            <StackPanel Grid.Row="1" Orientation="Horizontal">
                                <Button Content="{Binding SerialToolModel.WhileReadButton}"
                                        Command="{Binding  WhileReadCommand}"
                                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Page}}" />
                                <Button Name="OneReadButton" Content="单次读取" Margin="20 0 "
                                        Command="{Binding OneReadCommand}" />
                                <Button Content="清空"
                                        Command="{Binding ClearCommand}" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <GroupBox Header="发送">
                                <TextBox
                                    Name="SendMessageTextBox"
                                    Style="{x:Null}"
                                    TextWrapping="Wrap"
                                    AcceptsReturn="True"
                                    BorderThickness="0"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                    Text="{Binding SerialToolModel.SendMessageText}"/>
                            </GroupBox>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="15 2 ">
                                <Button  Content="发送(携带结束符)" HorizontalAlignment="Right"  Width="130" Command="{Binding WriteLineCommand }"/>
                                <Button  Content="发送(无结束符)" HorizontalAlignment="Right" Margin="20  0 0 0 " Width="130" Command="{Binding WriteCommand}" />
                                <Button  Content="发送并且等待" HorizontalAlignment="Right" Margin="20  0 0 0 " Width="130" Command="{Binding WriteAndWaitResponseCommand}" />
                            </StackPanel>
                           
                        </Grid>
                    </Grid>
                </Border>
            </GroupBox>
        </Grid>

        <ui:SnackbarPresenter Name="SnackbarPresenter" />
    </Grid>
</Page>