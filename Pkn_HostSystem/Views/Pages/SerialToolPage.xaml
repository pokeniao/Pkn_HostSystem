<Page x:Class="Pkn_HostSystem.Views.Pages.SerialToolPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:page="clr-namespace:Pkn_HostSystem.ViewModels.Page"
      mc:Ignorable="d"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"

      d:DataContext="{d:DesignInstance page:SerialToolViewModel}"
      d:DesignHeight="714.5" d:DesignWidth="1000"
      Title="SerialToolPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <GroupBox Header="配置串口" Margin="10">
                <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.7*" />
                            <RowDefinition Height="0.3*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <WrapPanel>
                                <TextBlock Text="端口号" Margin="10" />
                                <ComboBox Width="120"  ItemsSource="{Binding SerialToolModel.ComList}"
                                          SelectedValue="{Binding SerialToolModel.Com}"/>
                            </WrapPanel>
                            <WrapPanel>
                                <TextBlock Text="波特率" Margin="10" />
                                <ComboBox Width="120" ItemsSource="{Binding SerialToolModel.BaudRates}"
                                          SelectedValue="{Binding SerialToolModel.BaudRate}"/>
                            </WrapPanel>
                            <WrapPanel>
                                <TextBlock Text="数据位" Margin="10" />
                                <ComboBox Width="120" ItemsSource="{Binding SerialToolModel.DataBitss}"
                                          SelectedValue="{Binding SerialToolModel.DataBits}"/>
                            </WrapPanel>

                            <WrapPanel>
                                <TextBlock Text="停止位" Margin="10" />
                                <ComboBox Width="120" ItemsSource="{Binding SerialToolModel.StopBitsList}"
                                          SelectedValue="{Binding SerialToolModel.StopBits}"/>
                            </WrapPanel>
                            <WrapPanel>
                                <TextBlock Text="校验位" Margin="10" />
                                <ComboBox Width="120" ItemsSource="{Binding SerialToolModel.Parities}"
                                          SelectedValue="{Binding SerialToolModel.Paritie}"/>
                            </WrapPanel>
                            <WrapPanel>
                                <TextBlock Text="结束符" Margin="10" />
                                <ComboBox Width="120" ItemsSource="{Binding SerialToolModel.NewLines}"
                                          SelectedValue="{Binding SerialToolModel.NewLine}"
                                          DisplayMemberPath="Key"
                                          SelectedValuePath="Value"/>
                            </WrapPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1">
                            <Button Content="连接" />
                        </StackPanel>
                    </Grid>
                </Border>
            </GroupBox>
        </Grid>
        <Grid Grid.Column="1">
            <GroupBox Header="接受发送" Margin="10">
                <Border Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <GroupBox Header="接收">
                                <TextBox  Style="{x:Null}" 
                                          TextWrapping="Wrap"
                                          AcceptsReturn="True"
                                          IsReadOnly="True"
                                          BorderThickness="0"/>
                            </GroupBox>
                      
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition  Height="*"/>
                                <RowDefinition  Height="Auto"/>
                            </Grid.RowDefinitions>
                            <GroupBox Header="发送">
                                <TextBox  Style="{x:Null}" 
                                          TextWrapping="Wrap"
                                          AcceptsReturn="True"
                                          BorderThickness="0"/>
                            </GroupBox>
                            <Button Grid.Row="1" Content="发送" HorizontalAlignment="Right" Margin="15 2 " Width="70"/>
                        </Grid>
                    </Grid>
                </Border>
            </GroupBox>
        </Grid>

        <ui:SnackbarPresenter Name="SnackbarPresenter" />
    </Grid>
</Page>