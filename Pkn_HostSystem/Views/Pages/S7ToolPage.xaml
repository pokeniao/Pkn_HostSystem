<Page x:Class="Pkn_HostSystem.Views.Pages.S7ToolPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:page="clr-namespace:Pkn_HostSystem.ViewModels.Page"
      mc:Ignorable="d"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"

      d:DataContext="{d:DesignInstance page:S7ToolViewModel}"
      d:DesignHeight="714.5" d:DesignWidth="1000"
      Title="S7ToolPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ui:SnackbarPresenter Grid.Row="1" VerticalAlignment="Bottom" Grid.ColumnSpan="2" Name="SnackbarPresenter" />


        <Grid Grid.Column="0" Grid.Row="0">
            <Border
                Margin="10"
                CornerRadius="5"
                Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}">

                <StackPanel>
                    <WrapPanel Margin="10">
                        <TextBlock Text="CPU类型" Margin="5" TextAlignment="Center" />
                        <ComboBox
                            Width="250"
                            ItemsSource="{Binding S7Base.CpuTypes}"
                            SelectedValue="{Binding S7ToolModel.CpuType , UpdateSourceTrigger=PropertyChanged}" />
                    </WrapPanel>
                    <WrapPanel Margin="10">
                        <TextBlock Text="IP          " Margin="5" TextAlignment="Center" />
                        <ComboBox Name="cbb_modbus_tpc_ip" Width="250"
                                  IsEditable="True"
                                  ItemsSource="{Binding Ips}"
                                  SelectedIndex="0"
                                  Text="{Binding S7ToolModel.Ip , UpdateSourceTrigger=PropertyChanged}"
                                  DropDownOpened="ComboBox_DropDownOpened_1" />
                    </WrapPanel>

                    <WrapPanel Margin="10 0 0 10 ">
                        <TextBlock Text="端口号   " Margin="5" TextAlignment="Center" />
                        <ui:NumberBox
                            ClearButtonEnabled="False"
                            Minimum="0"
                            Width="130"
                            Value="{Binding S7ToolModel.Port,  UpdateSourceTrigger=PropertyChanged}" />
                    </WrapPanel>

                    <WrapPanel Margin="10 0 0 10 ">
                        <TextBlock Text="机架号   " Margin="5" TextAlignment="Center" />
                        <ui:NumberBox
                            ClearButtonEnabled="False"
                            Minimum="0"
                            Width="130"
                            Value="{Binding S7ToolModel.Rack,  UpdateSourceTrigger=PropertyChanged}" />
                    </WrapPanel>
                    <WrapPanel Margin="10 0 0 10 ">
                        <TextBlock Text="槽号      " Margin="5" TextAlignment="Center" />
                        <ui:NumberBox
                            ClearButtonEnabled="False"
                            Minimum="0"
                            Width="130"
                            Value="{Binding S7ToolModel.Slot,  UpdateSourceTrigger=PropertyChanged}" />
                    </WrapPanel>
                    <Button Content="{Binding S7ToolModel.RunButton}"
                            Margin="10"
                            Width="100"
                            Height="50"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Command="{Binding ConnectCommand}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="0">
            <Border
                Margin="10"
                CornerRadius="5"
                Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel>

                    <WrapPanel Margin="10 10 0 10">
                        <TextBlock Text="读写方法" Margin="5" TextAlignment="Center" />
                        <ComboBox
                            Width="150"
                            ItemsSource="{Binding  Methods}"
                            SelectedValue="{Binding S7ToolModel.Method , UpdateSourceTrigger=PropertyChanged}" />

                    </WrapPanel>
                    <WrapPanel Margin="10 0 0 10">
                        <TextBlock Text="内存区" Margin="5" TextAlignment="Center" />
                        <ComboBox
                            Width="80"
                            ItemsSource="{Binding S7ToolModel.DataAreaList}"
                            SelectedValue="{Binding S7ToolModel.DataArea , UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="编号" Margin="5" TextAlignment="Center" />
                        <ui:NumberBox
                            ClearButtonEnabled="False"
                            Minimum="0"
                            Width="110"
                            Value="{Binding S7ToolModel.NumberData,  UpdateSourceTrigger=PropertyChanged}" />
                        <WrapPanel Visibility="{Binding S7ToolModel.showOffset}">
                            <TextBlock Text="偏移量" Margin="5" TextAlignment="Center" />
                            <ui:NumberBox
                                ClearButtonEnabled="False"
                                Minimum="0"
                                SmallChange="0.1"
                                Width="110"
                                Value="{Binding S7ToolModel.Offset,  UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>

                    </WrapPanel>

                    <WrapPanel Margin="10 0 0 10">
                        <TextBlock Text="数量" Margin="5" TextAlignment="Center" />
                        <ui:NumberBox
                            ClearButtonEnabled="False"
                            Minimum="1"
                            Width="110"
                            Value="{Binding S7ToolModel.Num,  UpdateSourceTrigger=PropertyChanged}" />
                    </WrapPanel>
                    <GroupBox
                        Style="{x:Null}"
                        Margin="10 0 10 0"
                        Header="写入内容" BorderThickness="0.1"
                        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}">
                        <TextBox Text="{Binding S7ToolModel.AsciiStringMessage , UpdateSourceTrigger=PropertyChanged}" />
                    </GroupBox>

                    <Grid Margin="10 50 0 0 ">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                HorizontalAlignment="Center" Content="读取" Height="40" Width="80"
                                Command="{Binding ReadCommand}"/>
                        <Button Grid.Column="1"
                                HorizontalAlignment="Center" Content="写入" Height="40" Width="80" />

                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="0" Grid.Column="1">
            <Border 
                Margin="10"
                CornerRadius="5"
                Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition  Height="Auto"/> 
                        <RowDefinition  Height="*"/> 
                    </Grid.RowDefinitions>
                    <TextBlock Text="接收到数据" Margin="5"/>
                    <TextBox Grid.Row="1"
                        Name="AcceptMessageTextBox"
                        Style="{x:Null}"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        IsReadOnly="True"
                        BorderThickness="0"
                        Margin=" 5 0"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                        Text="{Binding S7ToolModel.AcceptMessageText }" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1">
            <Border 
                Margin="10"
                CornerRadius="5"
                Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition  Height="Auto"/>
                        <RowDefinition  Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="发送数据" Margin="5"/>
                    <TextBox
                        Grid.Row="1"
                        Name="SendMessageTextBox"
                        Style="{x:Null}"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        IsReadOnly="True"
                        BorderThickness="0"
                        Margin=" 5 0"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                        Text="{Binding S7ToolModel.SendMessageText }" />
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Page>