<UserControl x:Class="Pkn_HostSystem.Views.UserControls.OperationDataGrid.PknOperationDataGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Pkn_HostSystem.Views.UserControls.OperationDataGrid"
             xmlns:converter="clr-namespace:Pkn_HostSystem.Base.Converter"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.Resources>
            <converter:IsEnableConvertReadOnlyConverter x:Key="IsEnableConvertReadOnlyConverter" />
        </Grid.Resources>
        <DataGrid
            Name="DataGrid"
            Margin="5 0"
            AutoGenerateColumns="False"
            ItemsSource="{Binding NeedItemSource, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="删除" Click="MenuItem_OnClick" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="名称" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox
                                IsReadOnly="{Binding NameReadOnly ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                Text="{Binding Name , UpdateSourceTrigger=PropertyChanged , Mode=TwoWay}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="方式" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ParamMethod ,  Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox
                                SelectedValuePath="Content"
                                IsEnabled="{Binding MethodReadOnly , Converter={StaticResource IsEnableConvertReadOnlyConverter}  ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                SelectedValue="{Binding ParamMethod ,  Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem Content="常量" />
                                <ComboBoxItem Content="动态获取" />
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="参数" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock
                                    Visibility="{Binding ShowStaticParamVisibility}"
                                    Text="{Binding ParamValue ,  Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                    MaxHeight="100" />
                                <TextBlock
                                    Visibility="{Binding ShowDynamicParamVisibility}"
                                    Text="{Binding DynName,  Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                    MaxHeight="100" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBox Visibility="{Binding ShowStaticParamVisibility}"
                                         IsReadOnly="{Binding ValueReadOnly ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                         Text="{Binding ParamValue ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                         MaxHeight="100"
                                         HorizontalScrollBarVisibility="Visible"
                                         VerticalScrollBarVisibility="Visible" />
                                <ComboBox
                                    IsEnabled="{Binding ValueReadOnly , Converter={StaticResource IsEnableConvertReadOnlyConverter}  ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                    DropDownOpened="ComboBox_OnDropDownOpened"
                                    DisplayMemberPath="Name"
                                    Visibility="{Binding ShowDynamicParamVisibility}"
                                    ItemsSource="{Binding InputParams, RelativeSource={RelativeSource AncestorType=UserControl} }"
                                    SelectedValue="{Binding Dyn,  Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>