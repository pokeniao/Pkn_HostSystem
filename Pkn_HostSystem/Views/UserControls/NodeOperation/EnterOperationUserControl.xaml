<UserControl x:Class="Pkn_HostSystem.Views.UserControls.NodeOperation.EnterOperationUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:operationDataGrid="clr-namespace:Pkn_HostSystem.Views.UserControls.OperationDataGrid"
             xmlns:node="clr-namespace:Pkn_HostSystem.NodifyControl.Node"
             mc:Ignorable="d" 
             d:DesignHeight="407" d:DesignWidth="338"
             d:DataContext="{d:DesignInstance  node:EnterOperationNode}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <WrapPanel Margin="5">
                <TextBlock Text="传入参数" />
            </WrapPanel>
            <operationDataGrid:PknOperationDataGrid  
                Inputs ="{Binding}"
                NeedItemSource="{Binding OutputParams, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>


        </StackPanel>

           
    </Grid>
</UserControl>
