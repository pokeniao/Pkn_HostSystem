<UserControl x:Class="Pkn_HostSystem.Views.UserControls.NodeOperation.AddOperationUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Pkn_HostSystem.Views.UserControls.NodeOperation"
             xmlns:operationDataGrid="clr-namespace:Pkn_HostSystem.Views.UserControls.OperationDataGrid"
             xmlns:node="clr-namespace:Pkn_HostSystem.NodifyControl.Node"
             mc:Ignorable="d"
             d:DesignHeight="407" d:DesignWidth="338"
             d:DataContext="{d:DesignInstance  node:AddOperationNode}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="输入" Margin="5" />
        <operationDataGrid:PknOperationDataGrid  Grid.Row="1"
                                                 Inputs ="{Binding Input}"
                                                 NeedItemSource="{Binding InputParams , Mode=TwoWay }"/>
        <TextBlock Grid.Row="2" Text="输出" Margin="5" />
        <operationDataGrid:PknOperationDataGrid  Grid.Row="3" 
                                                 Inputs ="{Binding Input}"
                                                 NeedItemSource="{Binding OutputParams }"/>
    </Grid>
</UserControl>