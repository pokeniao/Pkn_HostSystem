<ui:FluentWindow x:Class="Pkn_HostSystem.Views.Windows.LoadMesAddWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:windows="clr-namespace:Pkn_HostSystem.ViewModels.Windows"
                 xmlns:converter="clr-namespace:Pkn_HostSystem.Base.Converter"
                 xmlns:pkn="clr-namespace:Pkn_HostSystem.MyControl"

                 d:DataContext="{d:DesignInstance windows:LoadMesAddAndUpdateWindowsViewModel}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 ExtendsContentIntoTitleBar="True"
                 WindowStyle="None"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 mc:Ignorable="d"
                 MaxWidth="900"
                 Width="900"
                 Height="800"
                 Loaded="FrameworkElement_OnLoaded"
                 WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <converter:BooleanVisibilityConverter x:Key="BooleanVisibilityConverter" />
        <converter:NewRowAllowButtonConverter x:Key="NewRowAllowButtonConverter" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.ColumnSpan="2">
            <Border VerticalAlignment="Center" Height="40" MouseDown="Border_MouseDown">
                <TextBlock Name="Title" FontWeight="Black" FontSize="16" Margin="30,9" />
            </Border>
        </Grid>
        <Grid Grid.Row="1">
            <StackPanel>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="23*" />
                        <RowDefinition Height="175*" />
                    </Grid.RowDefinitions>
                    <StackPanel HorizontalAlignment="Center" ZIndex="1" Grid.RowSpan="2">
                        <WrapPanel Margin="0,10,0,0">
                            <TextBlock Name="HTTP_Name" Text="名称" Margin="5" />
                            <TextBox Width="300" Text="{Binding LoadMesAddAndUpdateWindowModel.Name}" />
                        </WrapPanel>
                        <WrapPanel Margin="0,10,0,0">
                            <TextBlock Text="{Binding LoadMesAddAndUpdateWindowModel.CycText}" Margin="5" />
                            <ui:NumberBox
                                Minimum="1"
                                Value="{Binding LoadMesAddAndUpdateWindowModel.CycTime ,UpdateSourceTrigger=PropertyChanged ,Mode=TwoWay }"
                                Width="120" />
                            <TextBlock Text="触发类型" Margin="5" TextAlignment="Center" />
                            <ComboBox ItemsSource="{Binding TriggerType}" Width="110"
                                      SelectedValue="{Binding LoadMesAddAndUpdateWindowModel.TriggerType}"
                                      SelectionChanged="Selector_OnSelectionChanged" />
                        </WrapPanel>

                        <WrapPanel Margin="0,10,0,0">
                            <TextBlock Text="保存本地" Margin="5" VerticalAlignment="Center" />
                            <ui:ToggleSwitch Margin="5"
                                             IsChecked="{Binding LoadMesAddAndUpdateWindowModel.LocalSave }"
                                             Click="LocalSaveButton_OnClick" />
                            <Border Width="2" Height="25"
                                    Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}" />
                            <TextBlock Text="发送HTTP请求" Margin="5" VerticalAlignment="Center" />
                            <ui:ToggleSwitch Margin="5" IsChecked="{Binding LoadMesAddAndUpdateWindowModel.HttpNeed }"
                                             Click="ToggleButton_OnChecked" />
                            <Border Width="2" Height="25"
                                    Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}" />
                            <TextBlock Text="结果转发" Margin="5" VerticalAlignment="Center" />
                            <ui:ToggleSwitch Margin="5"
                                             IsChecked="{Binding LoadMesAddAndUpdateWindowModel.TranspondNeed }" />
                        </WrapPanel>

                        <WrapPanel Margin="0,10,0,0">
                            <TextBlock Text="选择工位" Margin="5" VerticalAlignment="Center" />
                            <ComboBox
                                Margin="10,0"
                                Width="170"
                                ItemsSource="{Binding Stations}"
                                DisplayMemberPath="Header"
                                SelectedValuePath="Header"
                                SelectedValue="{Binding LoadMesAddAndUpdateWindowModel.Station}" />
                            <ui:ToggleSwitch OnContent="启用工位记录" OffContent="停用工位记录"
                                             IsChecked="{Binding LoadMesAddAndUpdateWindowModel.NeedStationLog }" />
                        </WrapPanel>

                        <TabControl
                            Name="SetTabControl"
                            Margin="0,10,0,0">
                            <TabItem
                                Width="110"
                                Visibility="{Binding LoadMesAddAndUpdateWindowModel.ShowHttpSet ,Converter={StaticResource BooleanVisibilityConverter}}">
                                <TabItem.Header>
                                    <TextBlock Text="Http请求" />
                                </TabItem.Header>
                                <Grid
                                    Visibility="{Binding LoadMesAddAndUpdateWindowModel.ShowHttpSet ,Converter={StaticResource BooleanVisibilityConverter}}">
                                    <StackPanel>
                                        <WrapPanel Margin="0,10,0,0">
                                            <TextBlock Text="请求" Margin="5" />
                                            <ComboBox Width="100"
                                                      Text="{Binding LoadMesAddAndUpdateWindowModel.Ajax}">
                                                <ComboBoxItem Content="GET" />
                                                <ComboBoxItem Content="POST" />
                                                <ComboBoxItem Content="UPDATE" />
                                                <ComboBoxItem Content="DELETE" />
                                            </ComboBox>
                                            <TextBlock Text="格式" Margin="5" />
                                            <ComboBox Width="100"
                                                      SelectedValue="{Binding LoadMesAddAndUpdateWindowModel.RequestMethod}"
                                                      ItemsSource="{Binding RequestMethods }" />
                                        </WrapPanel>
                                        <WrapPanel Margin="0,10,0,0">
                                            <TextBlock Text="HTTP路径" Margin="5" />
                                            <TextBox Width="300"
                                                     Text="{Binding LoadMesAddAndUpdateWindowModel.HttpPath,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" />
                                        </WrapPanel>
                                        <WrapPanel Margin="0,10,0,0">
                                            <TextBlock Text="API接口" Margin="5" />
                                            <TextBox Width="300"
                                                     Text="{Binding LoadMesAddAndUpdateWindowModel.Api,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </TabItem>
                            <TabItem
                                Width="110"
                                Visibility="{Binding  LoadMesAddAndUpdateWindowModel.ShowTriggerSet ,Converter={StaticResource BooleanVisibilityConverter}}">
                                <TabItem.Header>
                                    <TextBlock Text="触发设置" />
                                </TabItem.Header>
                                <Grid
                                    Visibility="{Binding  LoadMesAddAndUpdateWindowModel.ShowTriggerSet ,Converter={StaticResource BooleanVisibilityConverter}}">
                                    <StackPanel>
                                        <WrapPanel Margin="0,10,0,0">
                                            <TextBlock Text="触发对象" Margin="5" TextAlignment="Center" />
                                            <ComboBox Width="200"
                                                      ItemsSource="{Binding LoadMesAddAndUpdateWindowModel.NetWorkList}"
                                                      DisplayMemberPath="NetworkDetailed.Name"
                                                      SelectedValuePath="NetworkDetailed.Name"
                                                      SelectionChanged="Selector_OnSelectionChanged2"
                                                      SelectedValue="{Binding LoadMesAddAndUpdateWindowModel.TriggerConnectName,UpdateSourceTrigger=PropertyChanged}" />
                                        </WrapPanel>
                                        <WrapPanel Margin="0,10,0,0">
                                            <TextBlock Text="内部调用(完成流程返回时)" Margin="5" VerticalAlignment="Center" />
                                            <ui:ToggleSwitch OnContent="启用" OffContent="停用"
                                                             IsChecked="{Binding LoadMesAddAndUpdateWindowModel.NeedInteriorTrigger }" />
                                        </WrapPanel>
                                        <WrapPanel Margin="0,10,0, 0">
                                            <TextBlock Text="内部调用寄存器" Margin="5" VerticalAlignment="Center" />
                                            <ui:NumberBox Width="130"
                                                          Value="{Binding LoadMesAddAndUpdateWindowModel.NeedInteriorTriggerIndex , UpdateSourceTrigger= PropertyChanged}" />
                                        </WrapPanel>
                                        <WrapPanel Margin="0,10,0,10">
                                            <TextBlock Text="内部调用寄存器超时(s)" Margin="5" VerticalAlignment="Center" />
                                            <ui:NumberBox Width="130"
                                                          Value="{Binding LoadMesAddAndUpdateWindowModel.NeedInteriorTriggerTimeOut , UpdateSourceTrigger= PropertyChanged}" />
                                        </WrapPanel>
                                        <Grid>
                                            <GroupBox Header="MODBUS触发"
                                                      Visibility="{Binding LoadMesAddAndUpdateWindowModel.ShowModbusTriggerParam ,Converter={StaticResource BooleanVisibilityConverter}}">
                                                <StackPanel>
                                                    <WrapPanel Margin="0,10,0,0">
                                                        <TextBlock Text="触发消息(Int)" Margin="5" TextAlignment="Center" />
                                                        <ui:NumberBox Width="150"
                                                                      ClearButtonEnabled="False"
                                                                      Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                                      BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                      BorderThickness="0"
                                                                      FontSize="15"
                                                                      Value="{Binding LoadMesAddAndUpdateWindowModel.TriggerMessage ,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" />
                                                    </WrapPanel>

                                                    <WrapPanel Margin="0,10,0,0">
                                                        <TextBlock Text="触发模式" Margin="5" TextAlignment="Center" />
                                                        <ComboBox Width="150"
                                                                  ItemsSource="{Binding TriggerReturnMethodList}"
                                                                  SelectedValue="{Binding LoadMesAddAndUpdateWindowModel.TriggerReturnMethod,UpdateSourceTrigger= PropertyChanged}" />
                                                    </WrapPanel>

                                                    <StackPanel
                                                        Visibility="{Binding LoadMesAddAndUpdateWindowModel.showTriggerReturnStatic , Converter={StaticResource BooleanVisibilityConverter}}">

                                                        <WrapPanel Margin="0,10,0,0">
                                                            <TextBlock Text="完成返回消息(Int)" Margin="5"
                                                                       TextAlignment="Center" />
                                                            <ui:NumberBox Width="150"
                                                                          ClearButtonEnabled="False"
                                                                          Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                                          BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                          BorderThickness="0"
                                                                          FontSize="15"
                                                                          Value="{Binding LoadMesAddAndUpdateWindowModel.SuccessResponseMessage ,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" />
                                                        </WrapPanel>
                                                        <WrapPanel Margin="0,10,0,0">
                                                            <TextBlock Text="失败返回消息(Int)" Margin="5" />
                                                            <ui:NumberBox Width="150"
                                                                          ClearButtonEnabled="False"
                                                                          Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                                          BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                          BorderThickness="0"
                                                                          FontSize="15"
                                                                          Value="{Binding LoadMesAddAndUpdateWindowModel.FailResponseMessage ,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" />
                                                        </WrapPanel>

                                                    </StackPanel>

                                                    <StackPanel
                                                        Visibility="{Binding LoadMesAddAndUpdateWindowModel.showTriggerReturnInterior,Converter={StaticResource BooleanVisibilityConverter}}">
                                                        <WrapPanel Margin="0,10,0,0">
                                                            <TextBlock Text="返回成功内部地址" Margin="5" />
                                                            <ui:NumberBox Width="150"
                                                                          ClearButtonEnabled="False"
                                                                          Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                                          BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                          BorderThickness="0"
                                                                          Minimum="0"
                                                                          Maximum="99"
                                                                          FontSize="15"
                                                                          Value="{Binding LoadMesAddAndUpdateWindowModel.InteriorResponseIndex ,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" />
                                                        </WrapPanel>
                                                        <WrapPanel Margin="0,10,0,0">
                                                            <TextBlock Text="执行失败返回消息(Int)" Margin="5" />
                                                            <ui:NumberBox Width="150"
                                                                          ClearButtonEnabled="False"
                                                                          Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                                          BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                          BorderThickness="0"
                                                                          FontSize="15"
                                                                          Value="{Binding LoadMesAddAndUpdateWindowModel.FailResponseMessage ,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                    <WrapPanel Margin="0,10,0,0">
                                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                                            <TextBlock Text="站地址" Margin="5" TextAlignment="Center" />
                                                            <ui:NumberBox
                                                                ClearButtonEnabled="False"
                                                                Value="{Binding LoadMesAddAndUpdateWindowModel.StationAddress ,UpdateSourceTrigger=PropertyChanged}"
                                                                Width="120" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                                            <TextBlock Text="起始地址" Margin="5" TextAlignment="Center" />
                                                            <ui:NumberBox
                                                                ClearButtonEnabled="False"
                                                                Value="{Binding LoadMesAddAndUpdateWindowModel.StartAddress ,UpdateSourceTrigger=PropertyChanged}"
                                                                Width="120" />
                                                        </StackPanel>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </GroupBox>
                                            <GroupBox Header="基恩士触发"
                                                      Visibility="{Binding LoadMesAddAndUpdateWindowModel.ShowKeyenceHostLinkParam ,Converter={StaticResource BooleanVisibilityConverter}}">
                                                <StackPanel>
                                                    <WrapPanel Margin="0,10,0,0">
                                                        <TextBlock Text="触发消息(Int)" Margin="5" TextAlignment="Center" />
                                                        <ui:NumberBox Width="150"
                                                                      ClearButtonEnabled="False"
                                                                      Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                                      BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                      BorderThickness="0"
                                                                      FontSize="15"
                                                                      Value="{Binding LoadMesAddAndUpdateWindowModel.TriggerMessage ,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" />
                                                    </WrapPanel>

                                                    <WrapPanel Margin="0,10,0,0">
                                                        <TextBlock Text="触发模式" Margin="5" TextAlignment="Center" />
                                                        <ComboBox Width="150"
                                                                  ItemsSource="{Binding TriggerReturnMethodList}"
                                                                  SelectedValue="{Binding LoadMesAddAndUpdateWindowModel.TriggerReturnMethod,UpdateSourceTrigger= PropertyChanged}" />
                                                    </WrapPanel>
                                                    <StackPanel
                                                        Visibility="{Binding LoadMesAddAndUpdateWindowModel.showTriggerReturnStatic , Converter={StaticResource BooleanVisibilityConverter}}">
                                                        <WrapPanel Margin="0,10,0,0">
                                                            <TextBlock Text="完成返回消息(Int)" Margin="5"
                                                                       TextAlignment="Center" />
                                                            <ui:NumberBox Width="150"
                                                                          ClearButtonEnabled="False"
                                                                          Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                                          BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                          BorderThickness="0"
                                                                          FontSize="15"
                                                                          Value="{Binding LoadMesAddAndUpdateWindowModel.SuccessResponseMessage ,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" />
                                                        </WrapPanel>
                                                        <WrapPanel Margin="0,10,0,0">
                                                            <TextBlock Text="失败返回消息(Int)" Margin="5" />
                                                            <ui:NumberBox Width="150"
                                                                          ClearButtonEnabled="False"
                                                                          Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                                          BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                          BorderThickness="0"
                                                                          FontSize="15"
                                                                          Value="{Binding LoadMesAddAndUpdateWindowModel.FailResponseMessage ,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                    <StackPanel
                                                        Visibility="{Binding LoadMesAddAndUpdateWindowModel.showTriggerReturnInterior,Converter={StaticResource BooleanVisibilityConverter}}">
                                                        <WrapPanel Margin="0,10,0,0">
                                                            <TextBlock Text="返回成功内部地址" Margin="5" />
                                                            <ui:NumberBox Width="150"
                                                                          ClearButtonEnabled="False"
                                                                          Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                                          BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                          BorderThickness="0"
                                                                          Minimum="0"
                                                                          Maximum="99"
                                                                          FontSize="15"
                                                                          Value="{Binding LoadMesAddAndUpdateWindowModel.InteriorResponseIndex ,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" />
                                                        </WrapPanel>
                                                        <WrapPanel Margin="0,10,0,0">
                                                            <TextBlock Text="执行失败返回消息(Int)" Margin="5" />
                                                            <ui:NumberBox Width="150"
                                                                          ClearButtonEnabled="False"
                                                                          Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                                          BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                          BorderThickness="0"
                                                                          FontSize="15"
                                                                          Value="{Binding LoadMesAddAndUpdateWindowModel.FailResponseMessage ,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" />
                                                        </WrapPanel>
                                                    </StackPanel>

                                                    <WrapPanel Margin="0,10,0,0">
                                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                                            <TextBlock Text="DM地址" Margin="5" TextAlignment="Center" />
                                                            <ui:NumberBox
                                                                ClearButtonEnabled="False"
                                                                Value="{Binding LoadMesAddAndUpdateWindowModel.StartAddress ,UpdateSourceTrigger=PropertyChanged}"
                                                                Width="120" />
                                                        </StackPanel>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </GroupBox>
                                        </Grid>

                                    </StackPanel>
                                </Grid>
                            </TabItem>
                            <TabItem
                                Width="110"
                                Visibility="{Binding  LoadMesAddAndUpdateWindowModel.ShowInteriorTriggerSet ,Converter={StaticResource BooleanVisibilityConverter}}">
                                <TabItem.Header>
                                    <TextBlock Text="内部触发" />
                                </TabItem.Header>
                                <Grid
                                    Visibility="{Binding  LoadMesAddAndUpdateWindowModel.ShowInteriorTriggerSet ,Converter={StaticResource BooleanVisibilityConverter}}">
                                    <StackPanel>
                                        <WrapPanel Margin="0,10,0,0">
                                            <TextBlock Text="触发内存数组" Margin="5" TextAlignment="Center" />
                                            <ui:NumberBox Width="150"
                                                          Minimum="0"
                                                          Maximum="100"
                                                          Value="{Binding LoadMesAddAndUpdateWindowModel.InteriorArrayIndex ,UpdateSourceTrigger=PropertyChanged}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </TabItem>
                            <TabItem
                                Width="110"
                                Visibility="{Binding LoadMesAddAndUpdateWindowModel.ShowLocalSave , Converter={StaticResource BooleanVisibilityConverter}}">
                                <TabItem.Header>
                                    <TextBlock Text="本地保存" />
                                </TabItem.Header>
                                <Grid>
                                    <StackPanel>
                                        <WrapPanel Margin="0 10">
                                            <TextBlock Text="保存目录方式" Margin="5"
                                                       TextAlignment="Center" />
                                            <ComboBox ItemsSource="{Binding LocalSaveDirectoryMethod}"
                                                      SelectedValue="{Binding LoadMesAddAndUpdateWindowModel.LocalSaveDirectoryMethod , UpdateSourceTrigger= PropertyChanged}"
                                                      Width="150" />
                                        </WrapPanel>
                                        <Grid
                                            Visibility="{Binding LoadMesAddAndUpdateWindowModel.ShowSaveDirectoryVisibility}"
                                            Margin=" 0 0 0 10">
                                            <WrapPanel>
                                                <TextBlock Text="目录名" Margin="5"
                                                           TextAlignment="Center" />
                                                <TextBox Text="{Binding LoadMesAddAndUpdateWindowModel.LocalSaveDirectoryPath ,UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                                            </WrapPanel>
                                        </Grid>
                                        <WrapPanel Margin="0 0 0 10">
                                            <TextBlock Text="保存文件名方式" Margin="5"
                                                       TextAlignment="Center" />
                                            <ComboBox ItemsSource="{Binding LocalSaveFileNameMethod}"
                                                      SelectedValue="{Binding LoadMesAddAndUpdateWindowModel.LocalSaveFileNameMethod , UpdateSourceTrigger= PropertyChanged}"
                                                      Width="150" />
                                        </WrapPanel>

                                        <Grid
                                            Visibility="{Binding LoadMesAddAndUpdateWindowModel.ShowSaveFileNameVisibility}"
                                            Margin=" 0 0 0 10">
                                            <WrapPanel>
                                                <TextBlock Text="文件名" Margin="5"
                                                           TextAlignment="Center" />
                                                <TextBox Text="{Binding LoadMesAddAndUpdateWindowModel.LocalSaveFileName ,UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                                            </WrapPanel>
                                        </Grid>

                                        <WrapPanel>
                                            <TextBlock Text="保存方式"
                                                       Margin="5"
                                                       TextAlignment="Center" />
                                            <ComboBox ItemsSource="{Binding LocalSaveMethod}"
                                                      SelectedValue="{Binding LoadMesAddAndUpdateWindowModel.LocalSaveMethod , UpdateSourceTrigger= PropertyChanged}"
                                                      Width="300" />
                                        </WrapPanel>
                                        <Grid
                                            Visibility="{Binding LoadMesAddAndUpdateWindowModel.ShowDayLocalSaveVisibility}"
                                            Margin="10">
                                            <StackPanel>
                                                <TextBlock Text="尚未完成" Foreground="Red" />
                                                <pkn:PknDateTimePicker />
                                            </StackPanel>
                                        </Grid>

                                        <Grid
                                            Visibility="{Binding LoadMesAddAndUpdateWindowModel.ShowTimeLocalSaveVisibility}"
                                            Margin="10">
                                            <pkn:PknTimePicker Width="270"
                                                               StartSelectedHour="{Binding LoadMesAddAndUpdateWindowModel.StartSelectedHour , UpdateSourceTrigger=PropertyChanged}"
                                                               StartSelectedMinute="{Binding LoadMesAddAndUpdateWindowModel.StartSelectedMinute , UpdateSourceTrigger=PropertyChanged}"
                                                               EndSelectedHour="{Binding LoadMesAddAndUpdateWindowModel.EndSelectedHour , UpdateSourceTrigger=PropertyChanged}"
                                                               EndSelectedMinute="{Binding LoadMesAddAndUpdateWindowModel.EndSelectedMinute , UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </StackPanel>


                                </Grid>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </Grid>
            </StackPanel>
            <Grid ZIndex="2" ColumnSpan="2">
                <ui:SnackbarPresenter HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                      Name="SnackbarPresenter" />
            </Grid>
        </Grid>
        <Grid Grid.Row="1" Grid.Column="1" Margin="15,0,10,10">
            <StackPanel>
                <StackPanel Margin="5">
                    <TabControl>
                        <TabItem>
                            <TabItem.Header>
                                <TextBlock Text="请求头" />
                            </TabItem.Header>
                            <DataGrid
                                Margin="5"
                                Name="HttpHeader"
                                Width="400" Height="150" BorderThickness="1" BorderBrush="AliceBlue"
                                CanUserAddRows="True"
                                AutoGenerateColumns="False"
                                Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                                IsReadOnly="False"
                                ItemsSource="{Binding LoadMesAddAndUpdateWindowModel.HttpHeaders}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Key" Width="*" Binding="{Binding Key}" />
                                    <DataGridTextColumn Header="Value" Width="*" Binding="{Binding Value}" />
                                    <DataGridTemplateColumn Header="删除" Width="0.5*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <CheckBox
                                                        Click="DeleteColForDg">
                                                        <CheckBox.IsEnabled>
                                                            <MultiBinding
                                                                Converter="{StaticResource NewRowAllowButtonConverter}">
                                                                <Binding
                                                                    RelativeSource="{RelativeSource AncestorType=DataGridRow}"
                                                                    Path="IsNewItem"
                                                                    Mode="OneWay" />
                                                                <Binding Path="NewCol" />
                                                            </MultiBinding>

                                                        </CheckBox.IsEnabled>
                                                    </CheckBox>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="请求体/消息体" Margin="5,0" />
                                    <ui:SymbolIcon Symbol="ChatWarning20" ToolTip="利用:[键名称] , 可以向消息体中嵌入参数" />
                                </StackPanel>
                            </TabItem.Header>
                            <GroupBox Header="内容"
                                      Width="400"
                                      Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <TextBox Width="400" Height="150" Style="{x:Null}"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                                         BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                         BorderThickness="0"
                                         AcceptsReturn="True"
                                         FontSize="15"
                                         Text="{Binding LoadMesAddAndUpdateWindowModel.Request ,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" />
                            </GroupBox>
                        </TabItem>
                    </TabControl>

                </StackPanel>
                <StackPanel Margin="5">
                    <GroupBox Header="嵌入键值对" BorderThickness="0">
                        <DataGrid
                            Name="ReqDataGrid"
                            Width="400" Height="270" BorderThickness="1" BorderBrush="AliceBlue"
                            CanUserAddRows="True"
                            AutoGenerateColumns="False"
                            Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                            ItemsSource="{Binding LoadMesAddAndUpdateWindowModel.Condition}"
                            IsReadOnly="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="键名称" Width="0.5*" Binding="{Binding Key}" />

                                <DataGridTemplateColumn Header="请求方式" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <TextBlock Margin="5,0" Text="{Binding Method }"></TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <ComboBox
                                                    ItemsSource="{Binding DataContext.ReqMethodList ,RelativeSource={RelativeSource AncestorType=Window}}"
                                                    SelectedValue="{Binding Method,UpdateSourceTrigger=PropertyChanged }" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="参数" Width="*">

                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <TextBlock Text="{Binding Value}" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <ComboBox
                                                    Visibility="{Binding show_para_dyn ,Converter={StaticResource BooleanVisibilityConverter}}"
                                                    ItemsSource="{Binding DataContext.Para_dyn ,  RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Text="{Binding Dyn_Value}"
                                                    DisplayMemberPath="Name" />
                                                <TextBox
                                                    Visibility="{Binding show_para_static ,Converter={StaticResource BooleanVisibilityConverter}}"
                                                    Text="{Binding Static_Value}" />

                                                <Grid
                                                    Visibility="{Binding show_method ,Converter={StaticResource BooleanVisibilityConverter}}">
                                                    <StackPanel>
                                                        <ComboBox
                                                            ItemsSource="{Binding DataContext. MethodCollection,  RelativeSource={RelativeSource AncestorType=Window}}"
                                                            Text="{Binding Method_value}" />
                                                        <TextBlock Text="其他参数" />
                                                        <TextBox Text="{Binding Method_OtherValue}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>


                                <DataGridTemplateColumn Header="删除" Width="0.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <CheckBox
                                                    Click="ButtonBase_OnClick">
                                                    <CheckBox.IsEnabled>
                                                        <MultiBinding
                                                            Converter="{StaticResource NewRowAllowButtonConverter}">
                                                            <Binding
                                                                RelativeSource="{RelativeSource AncestorType=DataGridRow}"
                                                                Path="IsNewItem"
                                                                Mode="OneWay" />
                                                            <Binding Path="IsNewLine" />
                                                        </MultiBinding>

                                                    </CheckBox.IsEnabled>
                                                </CheckBox>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </StackPanel>
            </StackPanel>

        </Grid>

        <DockPanel Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,15">
            <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right">
                <Button Content="确认" IsDefault="True"
                        Width="100" Command="{Binding ConfirmCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                <Button Content="取消" IsCancel="True"
                        Width="100" Margin="70,0" Command="{Binding CancelCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
            </WrapPanel>
        </DockPanel>
    </Grid>

</ui:FluentWindow>