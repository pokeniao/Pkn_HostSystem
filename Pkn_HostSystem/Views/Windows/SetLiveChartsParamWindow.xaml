<ui:FluentWindow x:Class="Pkn_HostSystem.Views.Windows.SetLiveChartsParamWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:windows="clr-namespace:Pkn_HostSystem.ViewModels.Windows"
                 mc:Ignorable="d"
                 WindowStartupLocation="CenterScreen"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 d:DataContext="{d:DesignInstance windows:SetLiveChartsParamViewModel}"
                 Title="SetLiveChartsParamWindow"
                 ExtendsContentIntoTitleBar="True"
                 WindowStyle="None"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 MaxWidth="900"
                 Width="900"
                 Height="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <GroupBox
            Grid.Row="0"
            Grid.Column="0"
            Header="产量统计/NG,OK率">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="选中配置"
                           Margin="5"
                           TextAlignment="Right" />
                <ComboBox Grid.Row="0" Grid.Column="1"
                          Margin="0 0 0 5"
                          ItemsSource="{Binding DynNetList }"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Name"
                          SelectedValue="{Binding LiveChartsModel.DayProductionDynName ,UpdateSourceTrigger=PropertyChanged}"
                          Width="150" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="配置导入"
                           Margin="5"
                           TextAlignment="Right" />
                <Button Grid.Row="1" Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Width="150"
                        Margin="0 0 0 5"
                        Content="导入到配置"
                        Command="{Binding DayTotalImportButtonCommand }" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="X轴坐标方式"
                           Margin="5"
                           TextAlignment="Right" />
                <WrapPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2">
                    <ComboBox Width="200"
                              Margin=" 0, 0 0 5"
                              ItemsSource="{Binding  XMethod}" 
                              SelectedValue="{Binding SetLiveChartsParamModel.XDayTimeMethod}"
                              />
                </WrapPanel>

                <TextBox Grid.Row="3" Grid.Column="1"
                         Grid.ColumnSpan="2"
                         Height="70"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Margin=" 0, 0 0 5"
                         Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                         BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                         Style="{x:Null}"
                         Text="{Binding SetLiveChartsParamModel.XAxesDayTimeLabelsYieldString  , UpdateSourceTrigger=PropertyChanged}" />


                <TextBlock Grid.Row="4" Grid.Column="0" Text="Y轴坐标方式"
                           Margin="5"
                           TextAlignment="Right" />
                <WrapPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin=" 0, 0 0 5">
                    <ComboBox Width="150"
                              ItemsSource="{Binding YMethod}" 
                              SelectedValue="{Binding SetLiveChartsParamModel.YDayTimeMethod}"
                              />
                </WrapPanel>
                <Button Grid.Row="6" Grid.Column="1"
                        Width="150"
                        Content="坐标配置设置"
                        Command="{Binding DateTimeAxisSetCommand }" />

                <ToggleButton Grid.Row="7" Grid.Column="2" Content="启用" 
                              IsChecked="{Binding  LiveChartsModel.DateTimeRun}"
                              HorizontalAlignment="Center" Width="100"/>
            </Grid>
        </GroupBox>


        <GroupBox
            Grid.Row="0"
            Grid.Column="1"
            Header="运行报警停机时长统计">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="选中配置"
                           Margin="5"
                           TextAlignment="Right" />
                <ComboBox Grid.Row="0" Grid.Column="1"
                          Margin="0 0 0 5"
                          ItemsSource="{Binding DynNetList }"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Name"
                          SelectedValue="{Binding LiveChartsModel.RunStopTimeDynName ,UpdateSourceTrigger=PropertyChanged}"
                          Width="150" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="配置导入"
                           Margin="5"
                           TextAlignment="Right" />
                <Button Grid.Row="1" Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Width="150"
                        Margin="0 0 0 5"
                        Content="导入到配置"
                        Command="{Binding RunTimeImportButtonCommand }" />
                <ToggleButton Grid.Row="7" Grid.Column="2" Content="启用" Margin="50 30 " 
                              IsChecked="{Binding LiveChartsModel.WaitAlarmRun}"
                              HorizontalAlignment="Center" Width="100"/>
            </Grid>
        </GroupBox>

        <GroupBox
            Grid.Row="1"
            Grid.Column="0"
            Header="OEE设置">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="选中配置"
                           Margin="5"
                           TextAlignment="Right" />
                <ComboBox Grid.Row="0" Grid.Column="1"
                          Margin="0 0 0 5"
                          ItemsSource="{Binding DynNetList }"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Name"
                          SelectedValue="{Binding LiveChartsModel.OeeDynName ,UpdateSourceTrigger=PropertyChanged}"
                          Width="150" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="配置导入"
                           Margin="5"
                           TextAlignment="Right" />
                <Button Grid.Row="1" Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Width="150"
                        Margin="0 0 0 5"
                        Content="导入到配置"
                        Command="{Binding OEEImportButtonCommand }" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="X轴坐标方式"
                           Margin="5"
                           TextAlignment="Right" />
                <WrapPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2">
                    <ComboBox Width="200"
                              Margin=" 0, 0 0 5"
                              SelectedValue="{Binding SetLiveChartsParamModel.XOeeMethod}"
                              ItemsSource="{Binding  XMethod}" />
                </WrapPanel>

                <TextBox Grid.Row="3" Grid.Column="1"
                         Grid.ColumnSpan="2"
                         Height="70"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Margin=" 0, 0 0 5"
                         Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                         BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                         Style="{x:Null}"
                         Text="{Binding SetLiveChartsParamModel.XAxesOeeLabelsYieldString  , UpdateSourceTrigger=PropertyChanged}" />


                <TextBlock Grid.Row="4" Grid.Column="0" Text="Y轴坐标方式"
                           Margin="5"
                           TextAlignment="Right" />
                <WrapPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin=" 0, 0 0 5">
                    <ComboBox Width="150"
                              SelectedValue="{Binding SetLiveChartsParamModel.YOeeMethod}"
                              ItemsSource="{Binding YMethod}" />
                </WrapPanel>
                <Button Grid.Row="6" Grid.Column="1"
                        Width="150"
                        Content="坐标配置设置"
                        Command="{Binding  OEEAxisSetCommand }" />
                <ToggleButton Grid.Row="7" Grid.Column="2" Content="启用" 
                              IsChecked="{Binding  LiveChartsModel.OeeRun}"
                              HorizontalAlignment="Center" Width="100"/>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="2" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Margin="30">

            <WrapPanel HorizontalAlignment="Left">

                <TextBlock Text="循环时间(ms)" TextAlignment="Center" Margin="5" />
                <ui:NumberBox
                    Value="{Binding LiveChartsModel.TimeCyc , UpdateSourceTrigger=PropertyChanged}"
                    ClearButtonEnabled="False"
                    Width="150"
                    Margin="0 0 10 0" />
                <Button
                    Name="RunButton"
                    Content="{Binding LiveChartsModel.RunLiveChartsButton}" Width="70"
                    Command="{Binding RunButtonCommand}" />
            </WrapPanel>

            <Button Content="关闭页面" Margin="30,0" Width="110" Click="ButtonBase_OnClick" HorizontalAlignment="Right" />

        </Grid>
        <ui:SnackbarPresenter Name="SnackbarPresenter" />
    </Grid>
</ui:FluentWindow>