<ui:FluentWindow x:Class="Pkn_HostSystem.Views.Windows.OnStartupWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:wpfAnimatedGif="http://wpfanimatedgif.codeplex.com"
                 mc:Ignorable="d"
                 WindowStartupLocation="CenterScreen"
                 ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
                 ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 d:DesignHeight="200" d:DesignWidth="400"
                 Title="OnStartupWindow" Height="200" Width="400" WindowStyle="None"
                 MinWidth="400"
                 MinHeight="250"
                 Background="#66ceff"
                >
    <Grid Background="#66ceff">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Image Grid.RowSpan="2" Grid.ColumnSpan="2" x:Name="MyGifImage"
               wpfAnimatedGif:ImageBehavior.AnimatedSource="../../Assets/LoadingGIF.gif"
               Stretch="None"/>


        <TextBlock Grid.Row="0" Grid.Column="0" Text="Loading...." FontSize="16" Margin="10" Foreground="#FF2218DA" FontFamily="Forte"/>

        <!-- <ui:ProgressRing Grid.Row="1" Grid.ColumnSpan="2"  IsIndeterminate="True" /> -->
        <ProgressBar  Grid.Row="1" Grid.ColumnSpan="2"  IsIndeterminate="True"/>
    </Grid>
</ui:FluentWindow>
