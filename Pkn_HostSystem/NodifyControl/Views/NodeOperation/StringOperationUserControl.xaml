<UserControl x:Class="Pkn_HostSystem.NodifyControl.Views.NodeOperation.StringOperationUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Pkn_HostSystem.NodifyControl.Views.NodeOperation"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:nodes="clr-namespace:Pkn_HostSystem.NodifyControl.Nodes"
             xmlns:operationDataGrid="clr-namespace:Pkn_HostSystem.Views.UserControls.OperationDataGrid"
             mc:Ignorable="d"
             d:DesignHeight="407" d:DesignWidth="338"
             ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
             ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             d:DataContext="{d:DesignInstance  nodes:StringOperationNode}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 方式 -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="字符串处理方法" TextAlignment="Center" Margin="5"
                   HorizontalAlignment="Left" />
        <ComboBox Grid.Row="0" Grid.Column="1"
                  Margin=" 0 0 0 5"
                  SelectedValuePath="Content"
                  SelectedValue="{Binding Model.Method, UpdateSourceTrigger=PropertyChanged , Mode=TwoWay}">
            <ComboBoxItem Content="拼接" />
            <ComboBoxItem Content="分割" />
            <ComboBoxItem Content="切割" />
        </ComboBox>

        <!-- 分割符 -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="分割符" TextAlignment="Center" Margin="5"
                   HorizontalAlignment="Left" />
        <TextBox Grid.Row="1" Grid.Column="1"
                 Margin=" 0 0 0 5"
                 Text="{Binding Model.Slicing , UpdateSourceTrigger= PropertyChanged , Mode=TwoWay}" />


        <!-- 切割 -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="切割起始位置" TextAlignment="Center" Margin="5"
                   HorizontalAlignment="Left" />
        <ui:NumberBox Grid.Row="2" Grid.Column="1"
                 Margin=" 0 0 0 5"
                 Value="{Binding Model.SlicingStartIndex , UpdateSourceTrigger= PropertyChanged , Mode=TwoWay}" />
        <TextBlock Grid.Row="3" Grid.Column="0" Text="切割" TextAlignment="Center" Margin="5"
                   HorizontalAlignment="Left" />
        <ui:NumberBox Grid.Row="3" Grid.Column="1"
                      Margin=" 0 0 0 5"
                      Value="{Binding Model.SlicingEndIndex , UpdateSourceTrigger= PropertyChanged , Mode=TwoWay}" />



        <TextBlock Grid.Row="4"
                   Grid.Column="0"
                   Text="输入" Margin="5" />
        <operationDataGrid:PknOperationDataGrid Grid.Row="5"
                                                Grid.ColumnSpan="2"
                                                Height="200"
                                                Node="{Binding}"
                                                NeedItemSource="{Binding InputParams , Mode=TwoWay }" />
        <TextBlock Grid.Row="6" Text="输出" Margin="5" />
        <operationDataGrid:PknOperationDataGrid Grid.Row="7"
                                                Grid.ColumnSpan="2"
                                                Height="200"
                                                Node="{Binding}"
                                                NeedItemSource="{Binding OutputParams }" />
    </Grid>
</UserControl>