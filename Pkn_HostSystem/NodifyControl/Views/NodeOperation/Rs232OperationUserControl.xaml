<UserControl x:Class="Pkn_HostSystem.NodifyControl.Views.NodeOperation.Rs232OperationUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Pkn_HostSystem.NodifyControl.Views.NodeOperation"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:nodes="clr-namespace:Pkn_HostSystem.NodifyControl.Nodes"
             xmlns:operationDataGrid="clr-namespace:Pkn_HostSystem.Views.UserControls.OperationDataGrid"
             mc:Ignorable="d"
             ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
             ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             d:DesignHeight="407" d:DesignWidth="338"
             d:DataContext="{d:DesignInstance  nodes:Rs232OperationNode}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!-- 通讯地址 -->
        <WrapPanel Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left">
            <TextBlock Text="通讯地址" TextAlignment="Center" Margin="5" />
            <TextBlock Text="{Binding Model.Rs232Model.NetworkName}" TextAlignment="Center" Margin="5" />
        </WrapPanel>
        <ComboBox
            Grid.Row="0"
            Grid.Column="1"
            Margin=" 0 0 0 5"
            Name="NetNameComboBox"
            ItemsSource="{Binding Model.Rs232Model.NetWorkList,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
            DisplayMemberPath="NetworkDetailed.Name"
            SelectedValuePath="NetworkDetailed.Name"
            SelectionChanged="NetNameComboBox_OnSelectionChanged"
            SelectedValue="{Binding  Model.Rs232Model.NetworkName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
        <!-- 通讯方式 -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="通讯方式" TextAlignment="Center" Margin="5"
                   HorizontalAlignment="Left" />
        <ComboBox Grid.Row="1" Grid.Column="1"
                  Margin=" 0 0 0 5"
                  SelectedValuePath="Content"
                  SelectedValue="{Binding Model.Rs232Model.NetMethodName, UpdateSourceTrigger=PropertyChanged , Mode=TwoWay}">
            <ComboBoxItem Content="发送并等待读取" />
            <ComboBoxItem Content="读取" />
            <ComboBoxItem Content="发送(携带结束符)" />
            <ComboBoxItem Content="发送(不带结束符)" />
        </ComboBox>

        <StackPanel
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Orientation="Horizontal">
            <Border
                Margin="5 0"
                Width="20"
                Height="2"
                BorderThickness="5"
                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" />
            <TextBlock Text="写入内容" Margin="5,0" />
            <ui:SymbolIcon Symbol="ChatWarning20" ToolTip="利用:[键名称] , 可以向消息体中嵌入参数" />
            <Border
                Margin="5 0"
                Width="500"
                Height="2"
                BorderThickness="5"
                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" />
        </StackPanel>

        <Border
            Grid.Row="3"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
            CornerRadius="5"
            Margin="5">
            <TextBox Height="150" Style="{x:Null}"
                     Margin="5"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                     BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                     BorderThickness="0"
                     AcceptsReturn="True"
                     FontSize="15"
                     Text="{Binding Model.Rs232Model.SendMessage ,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" />
        </Border>

        <TextBlock Grid.Row="4" Grid.Column="0"
                   Text="输入" Margin="5" />
        <operationDataGrid:PknOperationDataGrid  Grid.Row="5"
                                                 Grid.Column="0"
                                                 Grid.ColumnSpan="2"
                                                 Height="200"
                                                 Node="{Binding}"
                                                 NeedItemSource="{Binding InputParams , Mode=TwoWay }"/>
        <TextBlock Grid.Row="6" Grid.Column="0"
                   Text="输出" Margin="5" />
        <operationDataGrid:PknOperationDataGrid  Grid.Row="7" 
                                                 Grid.Column="0"
                                                 Grid.ColumnSpan="2"
                                                 Height="200"
                                                 Node="{Binding}"
                                                 NeedItemSource="{Binding OutputParams }"/>
    </Grid>
</UserControl>
