<UserControl x:Class="Pkn_HostSystem.NodifyControl.Views.NodeOperation.IfOperationUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:nodes="clr-namespace:Pkn_HostSystem.NodifyControl.Nodes"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:operationDataGrid="clr-namespace:Pkn_HostSystem.Views.UserControls.OperationDataGrid"
             mc:Ignorable="d" 
             d:DesignHeight="407" d:DesignWidth="338"
             ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
             ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             d:DataContext="{d:DesignInstance  nodes:IfOperationNode}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="表达式" Margin="5 0"/>
            <TextBlock Grid.Row="1" FontSize="8"  Text="&amp;&amp;, ||, >=, ==, &lt;=, >, &lt;, !=, ()" Margin="20 0"/>
            <TextBlock Grid.Row="2" FontSize="8"  Text="string.Count()  计算字符串的数量" Margin="20 0"/>
            <TextBlock Grid.Row="3" FontSize="8"  Text="string.Equals(,)  比较字符串是否相同" Margin="20 0"/>

            <Border
                Grid.Row="10"
                Margin="5,10"
                Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                Height="200"
                BorderThickness="1"
                CornerRadius="10">
                <TextBox
                    Name="MessageTextBox"
                    Margin="5"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto"
                    TextWrapping="Wrap"
                    AcceptsReturn="True"
                    Background="{x:Null}"
                    BorderBrush="{x:Null}"
                    BorderThickness="0"
                    Style="{x:Null}"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding Model.Expression  ,UpdateSourceTrigger= PropertyChanged }"
                    FontSize="16" />
            </Border>
        </Grid>


        <TextBlock Grid.Row="1" Text="输入" Margin="5" />
        <operationDataGrid:PknOperationDataGrid  Grid.Row="2"
                                                 Height="200"
                                                 Node="{Binding}"
                                                 NeedItemSource="{Binding InputParams , Mode=TwoWay }"/>
        <TextBlock Grid.Row="3" Text="输出" Margin="5" />
        <operationDataGrid:PknOperationDataGrid  Grid.Row="4" 
                                                 Height="200"
                                                 Node="{Binding}"
                                                 NeedItemSource="{Binding OutputParams }"/>

    </Grid>
</UserControl>
