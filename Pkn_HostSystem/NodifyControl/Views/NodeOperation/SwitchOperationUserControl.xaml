<UserControl x:Class="Pkn_HostSystem.NodifyControl.Views.NodeOperation.SwitchOperationUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Pkn_HostSystem.NodifyControl.Views.NodeOperation"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:nodes="clr-namespace:Pkn_HostSystem.NodifyControl.Nodes"
             xmlns:operationDataGrid="clr-namespace:Pkn_HostSystem.Views.UserControls.OperationDataGrid"
             mc:Ignorable="d"
             d:DesignHeight="407" d:DesignWidth="338"
             ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
             ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             d:DataContext="{d:DesignInstance  nodes:SwitchOperationNode}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 方式 -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="映射数量" TextAlignment="Center" Margin="5"
                   HorizontalAlignment="Left" />

        <ui:NumberBox
            Grid.Row="0" Grid.Column="1"
            Margin=" 0 0 0 5"
            Minimum="1"
            Value="{Binding Model.SwitchCount , UpdateSourceTrigger=PropertyChanged , Mode=TwoWay}"
            ValueChanged="TextBoxBase_OnSelectionChanged" />


        <TextBlock Grid.Row="6"
                   Grid.Column="0"
                   Text="输入" Margin="5" />
        <Button Grid.Row="6"
                Grid.Column="1" Content="刷新" Click="TextBoxBase_OnSelectionChanged" />
        <operationDataGrid:PknOperationDataGrid Grid.Row="8"
                                                Grid.ColumnSpan="2" Grid.Column="0"
                                                Height="200"
                                                Node="{Binding}"
                                                NeedItemSource="{Binding InputParams , Mode=TwoWay }" />
        <TextBlock Grid.Row="9" Grid.Column="0" Text="输出" Margin="5" />
        <operationDataGrid:PknOperationDataGrid Grid.Row="10"
                                                Grid.ColumnSpan="2" Grid.Column="0"
                                                Height="200"
                                                Node="{Binding}"
                                                NeedItemSource="{Binding OutputParams }" />
    </Grid>
</UserControl>