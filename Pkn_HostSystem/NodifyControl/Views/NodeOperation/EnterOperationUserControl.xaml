<UserControl x:Class="Pkn_HostSystem.NodifyControl.Views.NodeOperation.EnterOperationUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:operationDataGrid="clr-namespace:Pkn_HostSystem.Views.UserControls.OperationDataGrid"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:netWorkTrigger="clr-namespace:Pkn_HostSystem.Views.UserControls.NetWorkTrigger"
             xmlns:nodes="clr-namespace:Pkn_HostSystem.NodifyControl.Nodes"
             mc:Ignorable="d"
             ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
             ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             d:DesignHeight="407" d:DesignWidth="338"
             d:DataContext="{d:DesignInstance  nodes:EnterOperationNode}">
    <Grid VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="传入参数" Margin="5" />

        <operationDataGrid:PknOperationDataGrid
            Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
            Height="200"
            Margin="5"
            Grid.Row="1"
            Inputs="{Binding}"
            NeedItemSource="{Binding OutputParams, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />

        <netWorkTrigger:NetWorkTriggerUserControl
            Grid.Row="2"
            NetWorkTriggerModel="{Binding Model.NetWorkTriggerModel }"
            />
    </Grid>
</UserControl>