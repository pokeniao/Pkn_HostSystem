<UserControl x:Class="Pkn_HostSystem.NodifyControl.Views.NodeOperation.ModbusTcpOperationUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:nodes="clr-namespace:Pkn_HostSystem.NodifyControl.Nodes"
             xmlns:operationDataGrid="clr-namespace:Pkn_HostSystem.Views.UserControls.OperationDataGrid"
             xmlns:modbusTool="clr-namespace:Pkn_HostSystem.Services.Page.ModbusTool"
             mc:Ignorable="d"
             ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
             ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             d:DesignHeight="407" d:DesignWidth="338"
             d:DataContext="{d:DesignInstance  nodes:ModbusTcpOperationNode}">
    <UserControl.Resources>
        <modbusTool:openTextBoxbyTrue x:Key="openTextBoxbyTrue" />
        <modbusTool:openCheckBoxbyFalse x:Key="openCheckBoxbyFalse" />
    </UserControl.Resources>
    <Grid VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0">
            <TextBlock Text="通讯地址" TextAlignment="Center" Margin="5"/>
            <TextBlock Text="{Binding Model.NetWorkTriggerModel.NetworkName}" TextAlignment="Center" Margin="5"/>
            <ComboBox Width="150"
                      ItemsSource="{Binding Model.NetWorkTriggerModel.NetWorkList,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                      DisplayMemberPath="NetworkDetailed.Name"
                      SelectedValuePath="NetworkDetailed.Name"
                      SelectedValue="{Binding  Model.NetWorkTriggerModel.NetworkName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
        </WrapPanel>

        <WrapPanel Grid.Row="2"
                   Margin="0,10,0,0"
                   >
            <TextBlock Text="通讯方式" TextAlignment="Center" Margin="5"/>
            <ComboBox Width="150" 
                  SelectionChanged="ComboBox_SelectionChanged"
                  ItemsSource="{Binding Model.NetWorkTriggerModel.NetMethod,Mode= TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  SelectedValue="{Binding Model.NetWorkTriggerModel.NetMethodName , UpdateSourceTrigger=PropertyChanged , Mode=TwoWay}"
        />
        </WrapPanel>
        <WrapPanel Margin="0,10,0,0" Grid.Row="3"
                   Visibility="{Binding Model.NetWorkTriggerModel.showModbusTriggerParam}">
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="站地址" Margin="5" TextAlignment="Center" />
                <ui:NumberBox
                    ClearButtonEnabled="False"
                    Minimum="1"
                    Value="{Binding Model.NetWorkTriggerModel.StationAddress  ,UpdateSourceTrigger=PropertyChanged}"
                    Width="120" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="起始地址" Margin="5" TextAlignment="Center" />
                <ui:NumberBox
                    ClearButtonEnabled="False"
                    Minimum="0"
                    ValueChanged="NumberBox_ValueChanged"
                    Value="{Binding Model.NetWorkTriggerModel.StartAddress,UpdateSourceTrigger=PropertyChanged}"
                    Width="120" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="数量" Margin="5" TextAlignment="Center" />
                <ui:NumberBox
                    Minimum="1"
                    Name="NumberBox"
                    ClearButtonEnabled="False"
                    ValueChanged="NumberBox_ValueChanged"
                    Value="{Binding Model.NetWorkTriggerModel.Count,UpdateSourceTrigger=PropertyChanged , Mode=TwoWay}"
                    Width="120" />
            </StackPanel>
        </WrapPanel>


        <Grid  Grid.Row="4"
               Visibility="{Binding Model.NetWorkTriggerModel.showModbusTriggerParam}">
            <Grid.RowDefinitions>
                <RowDefinition  Height="Auto"/>
                <RowDefinition  Height="*"/>
            </Grid.RowDefinitions>
            <ui:TextBlock Grid.Row="0" Text="写入消息" Margin="30 5" FontSize="14" FontWeight="Black" HorizontalAlignment="Left"/>

            <DataGrid
                Grid.Row="1"
                Margin="10 0 15 20"
                Height="250"
                ItemsSource="{Binding Model.NetWorkTriggerModel.WriteDvgList , UpdateSourceTrigger=PropertyChanged , Mode=TwoWay}"
                Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                ColumnWidth="*"
                AutoGenerateColumns="false"
                CanUserAddRows="False"
            >
                <DataGrid.Columns>
                    <DataGridTextColumn Header="地址(address)" Width="*"
                                    Binding="{Binding Name ,  Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTemplateColumn Header="方式" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ParamMethod ,  Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox
                                SelectedValuePath="Content"
                                IsEnabled="{Binding IsEnable ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                SelectedValue="{Binding ParamMethod ,  Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBoxItem Content="常量" />
                                    <ComboBoxItem Content="动态获取" />
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="值(value)" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock 
                                    Visibility="{Binding ShowStaticParamVisibility}"
                                    Text="{Binding ParamValue ,  Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock 
                                    Visibility="{Binding ShowDynamicParamVisibility}"
                                    Text="{Binding DynName,  Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBox Visibility="{Binding ShowStaticParamVisibility}"
                                         IsEnabled="{Binding IsEnable ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                         Text="{Binding ParamValue ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox
                                    IsEnabled="{Binding IsEnable ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                    DropDownOpened="ComboBox_OnDropDownOpened"
                                    DisplayMemberPath="Name"
                                    Visibility="{Binding ShowDynamicParamVisibility}"
                                    ItemsSource="{Binding InputParams2, RelativeSource={RelativeSource AncestorType=UserControl} }"
                                    SelectedValue="{Binding Dyn,  Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>


        <!-- <TextBlock Grid.Row="5" Text="输入" Margin="5" /> -->
        <!-- <operationDataGrid:PknOperationDataGrid Grid.Row="6" -->
        <!--                                         Height="200" -->
        <!--                                         Node="{Binding}" -->
        <!--                                         NeedItemSource="{Binding InputParams , Mode=TwoWay }" /> -->

        <TextBlock Grid.Row="7" Text="输出" Margin="5" />
        <operationDataGrid:PknOperationDataGrid
            Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
            Height="200"
            Margin="5"
            Grid.Row="8"
            Node="{Binding}"
            NeedItemSource="{Binding OutputParams, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />



    </Grid>
</UserControl>