<UserControl x:Class="Pkn_HostSystem.NodifyControl.Views.NodeOperation.ModbusTcpOperationUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:nodes="clr-namespace:Pkn_HostSystem.NodifyControl.Nodes"
             xmlns:operationDataGrid="clr-namespace:Pkn_HostSystem.Views.UserControls.OperationDataGrid"
             xmlns:modbusTool="clr-namespace:Pkn_HostSystem.Services.Page.ModbusTool"
             xmlns:converter="clr-namespace:Pkn_HostSystem.Base.Converter"
             mc:Ignorable="d"
             ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
             ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             d:DesignHeight="407" d:DesignWidth="338"
             d:DataContext="{d:DesignInstance  nodes:ModbusTcpOperationNode}">
    <UserControl.Resources>
        <modbusTool:openTextBoxbyTrue x:Key="openTextBoxbyTrue" />
        <modbusTool:openCheckBoxbyFalse x:Key="openCheckBoxbyFalse" />
        <converter:IsEnableConvertReadOnlyConverter x:Key="IsEnableConvertReadOnlyConverter" />
    </UserControl.Resources>
    <Grid VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!-- 通讯地址 -->
        <WrapPanel Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left">
            <TextBlock Text="通讯地址" TextAlignment="Center" Margin="5" />
            <TextBlock Text="{Binding Model.NetWorkTriggerModel.NetworkName}" TextAlignment="Center" Margin="5" />
        </WrapPanel>
        <ComboBox
            Grid.Row="0"
            Grid.Column="1"
            Margin=" 0 0 0 5"
            Name="NetNameComboBox"
            ItemsSource="{Binding Model.NetWorkTriggerModel.NetWorkList,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
            SelectionChanged="Selector_OnSelectionChanged"
            DisplayMemberPath="NetworkDetailed.Name"
            SelectedValuePath="NetworkDetailed.Name"
            SelectedValue="{Binding  Model.NetWorkTriggerModel.NetworkName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
        <!-- 通讯方式 -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="通讯方式" TextAlignment="Center" Margin="5"
                   HorizontalAlignment="Left" />
        <ComboBox Grid.Row="1" Grid.Column="1"
                  SelectionChanged="ComboBox_SelectionChanged"
                  Margin=" 0 0 0 5"
                  ItemsSource="{Binding Model.NetWorkTriggerModel.NetMethod,Mode= TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  SelectedValue="{Binding Model.NetWorkTriggerModel.NetMethodName , UpdateSourceTrigger=PropertyChanged , Mode=TwoWay}" />

        <!-- 格式类型 -->
        <TextBlock
            Grid.Row="2" Grid.Column="0"
            Text="格式类型" Margin="5" TextAlignment="Center" HorizontalAlignment="Left" />
        <ComboBox
            Name="FormatComboBox"
            Grid.Row="2" Grid.Column="1"
            Margin="0 0 0 5"
            SelectedValuePath="Content"
            SelectionChanged="ComboBox_SelectionChanged"
            SelectedValue="{Binding Model.NetWorkTriggerModel.Format, UpdateSourceTrigger=PropertyChanged , Mode=TwoWay}"
        >
            <ComboBoxItem Content="单寄存器(无符号)" />
            <ComboBoxItem Content="单寄存器(有符号)" />
            <ComboBoxItem Content="双寄存器;无符号;BigEndian" />
            <ComboBoxItem Content="双寄存器;无符号;LittleEndian" />
            <ComboBoxItem Content="双寄存器;无符号;BigEndianByteSwap" />
            <ComboBoxItem Content="双寄存器;无符号;LittleEndianByteSwap" />
            <ComboBoxItem Content="双寄存器;有符号;BigEndian" />
            <ComboBoxItem Content="双寄存器;有符号;LittleEndian" />
            <ComboBoxItem Content="双寄存器;有符号;BigEndianByteSwap" />
            <ComboBoxItem Content="双寄存器;有符号;LittleEndianByteSwap" />
            <ComboBoxItem Content="32位浮点数;BigEndian" />
            <ComboBoxItem Content="32位浮点数;LittleEndian" />
            <ComboBoxItem Content="32位浮点数;BigEndianByteSwap" />
            <ComboBoxItem Content="32位浮点数;LittleEndianByteSwap" />
            <ComboBoxItem Content="ASCII字符串(高低位)" />
            <ComboBoxItem Content="ASCII字符串(低高位)" />
        </ComboBox>

        <!-- 站地址 -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="站地址" Margin="5" TextAlignment="Center" HorizontalAlignment="Left" />
        <ui:NumberBox
            Grid.Row="3" Grid.Column="1"
            Margin=" 0 0 0 5"
            ClearButtonEnabled="False"
            Minimum="1"
            Value="{Binding Model.NetWorkTriggerModel.StationAddress  ,UpdateSourceTrigger=PropertyChanged}" />

        <!-- 起始地址 -->
        <TextBlock
            Grid.Row="4" Grid.Column="0"
            Text="起始地址" Margin="5" TextAlignment="Center" HorizontalAlignment="Left" />
        <ui:NumberBox
            Grid.Row="4" Grid.Column="1"
            ClearButtonEnabled="False"
            Minimum="0"
            ValueChanged="NumberBox_ValueChanged"
            Value="{Binding Model.NetWorkTriggerModel.StartAddress,UpdateSourceTrigger=PropertyChanged}"
            Margin="0 0 0 5" />

        <!-- 数量 -->
        <TextBlock
            Grid.Row="5" Grid.Column="0"
            Text="数量" Margin="5" TextAlignment="Center" HorizontalAlignment="Left" />
        <ui:NumberBox
            Grid.Row="5" Grid.Column="1"
            Minimum="1"
            Name="NumberBox"
            ClearButtonEnabled="False"
            ValueChanged="NumberBox_ValueChanged"
            Value="{Binding Model.NetWorkTriggerModel.Count,UpdateSourceTrigger=PropertyChanged , Mode=TwoWay}"
            Margin="0 0 0 5" />


        <!-- 写入消息 -->
        <Grid Grid.Row="6" Grid.ColumnSpan="2" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ui:TextBlock Grid.Row="0" Text="写入消息" Margin="5" FontWeight="Black"
                          HorizontalAlignment="Left" />
            <DataGrid
                Grid.Row="1"
                Margin="5"
                Height="250"
                ItemsSource="{Binding Model.NetWorkTriggerModel.WriteDvgList , UpdateSourceTrigger=PropertyChanged , Mode=TwoWay}"
                Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                ColumnWidth="*"
                AutoGenerateColumns="false"
                CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="地址(address)" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Text="{Binding Name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="方式" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Text="{Binding ParamMethod ,  Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox
                                    SelectedValuePath="Content"
                                    IsEnabled="{Binding NameReadOnly ,Converter={StaticResource IsEnableConvertReadOnlyConverter} ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                    SelectedValue="{Binding ParamMethod ,  Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBoxItem Content="常量" />
                                    <ComboBoxItem Content="动态获取" />
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="值(value)" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock
                                        Visibility="{Binding ShowStaticParamVisibility}"
                                        Text="{Binding ParamValue ,  Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Visibility="{Binding ShowDynamicParamVisibility}"
                                        Text="{Binding DynName,  Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBox Visibility="{Binding ShowStaticParamVisibility}"
                                             IsReadOnly="{Binding ReadOnly ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                             Text="{Binding ParamValue ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox
                                        IsEnabled="{Binding ReadOnly ,Converter={StaticResource IsEnableConvertReadOnlyConverter} ,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                        DropDownOpened="ComboBox_OnDropDownOpened"
                                        DisplayMemberPath="Name"
                                        Visibility="{Binding ShowDynamicParamVisibility}"
                                        ItemsSource="{Binding InputParams2, RelativeSource={RelativeSource AncestorType=UserControl} }"
                                        SelectedValue="{Binding Dyn,  Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- 输出 -->
        <TextBlock Grid.Row="7" Grid.Column="0"
                   Text="输出" Margin="5" />
        <operationDataGrid:PknOperationDataGrid Grid.Column="0"
                                                Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                Height="200"
                                                Margin="5"
                                                Grid.Row="8"
                                                Grid.ColumnSpan="2"
                                                Node="{Binding}"
                                                NeedItemSource="{Binding OutputParams, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
    </Grid>
</UserControl>