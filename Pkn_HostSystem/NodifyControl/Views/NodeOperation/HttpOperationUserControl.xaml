<UserControl x:Class="Pkn_HostSystem.NodifyControl.Views.HttpOperationUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:nodes="clr-namespace:Pkn_HostSystem.NodifyControl.Nodes"
             xmlns:operationDataGrid="clr-namespace:Pkn_HostSystem.Views.UserControls.OperationDataGrid"
             mc:Ignorable="d"
             d:DesignHeight="407" d:DesignWidth="338"
             ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
             ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             d:DataContext="{d:DesignInstance  nodes:HttpOperationNode}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- 请求方式 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="请求" Margin="5" />
                <ComboBox Grid.Row="0" Grid.Column="1" Text="{Binding  Model.HttpMethod}"
                          HorizontalAlignment="Left"
                          Margin="0  0 0 5">
                    <ComboBoxItem Content="GET" />
                    <ComboBoxItem Content="POST" />
                    <ComboBoxItem Content="PUT" />
                    <ComboBoxItem Content="DELETE" />
                </ComboBox>
                <!-- ContentType -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="格式" Margin="5" />
                <ComboBox Grid.Row="1" Grid.Column="1" Text="{Binding  Model.ContentType}"
                          HorizontalAlignment="Left"
                          Margin="0  0 0 5">
                    <ComboBoxItem Content="application/json" />
                    <ComboBoxItem Content="application/xml" />
                    <ComboBoxItem Content="application/x-www-form-urlencoded" />
                    <ComboBoxItem Content="multipart/form-data" />
                </ComboBox>
                <!-- HTTP路径 -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="HTTP路径" Margin="5" />
                <TextBox Grid.Row="2" Grid.Column="1"
                         Text="{Binding Model.HttpPath,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                         Margin="0  0 0 5" />
                <!-- API接口 -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="API接口" Margin="5" />
                <TextBox Grid.Row="3" Grid.Column="1"
                         Text="{Binding Model.ApiPath,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                         Margin="0  0 0 5" />

                <StackPanel
                    Grid.Row="4"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal">
                    <Border
                        Margin="5 0"
                        Width="20"
                        Height="2"
                        BorderThickness="5"

                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" />
                    <TextBlock Text="请求头" />
                    <Border
                        Margin="5 0"
                        Width="500"
                        Height="2"
                        BorderThickness="5"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" />
                </StackPanel>


                <DataGrid
                    Grid.Row="5"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="5"
                    Name="HttpHeaderDataGrid"
                    Height="110" BorderThickness="1"
                    CanUserAddRows="True"
                    AutoGenerateColumns="False"
                    Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                    IsReadOnly="False"
                    ItemsSource="{Binding Model.HttpHeaders}">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="删除" Click="MenuItem_OnClick" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Key" Width="*" Binding="{Binding Key}" />
                        <DataGridTextColumn Header="Value" Width="*" Binding="{Binding Value}" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel
                    Grid.Row="6"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal">
                    <Border
                        Margin="5 0"
                        Width="20"
                        Height="2"
                        BorderThickness="5"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" />
                    <TextBlock Text="请求体" Margin="5,0" />
                    <ui:SymbolIcon Symbol="ChatWarning20" ToolTip="利用:[键名称] , 可以向消息体中嵌入参数" />
                    <Border
                        Margin="5 0"
                        Width="500"
                        Height="2"
                        BorderThickness="5"
                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" />
                </StackPanel>

                <DataGrid
                    Name="FormDataGrid"
                    Grid.Row="7"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="5"
                    Height="265"
                    BorderThickness="1"
                    CanUserAddRows="True"
                    AutoGenerateColumns="False"
                    Visibility="{Binding Model.ShowFromBodysVisibility}"
                    Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                    IsReadOnly="False"
                    ItemsSource="{Binding Model.FromBodys}">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="删除" Click="MenuItem_OnClick2" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>

                        <DataGridTemplateColumn Header="Key" Width="0.3*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock
                                            Height="200"
                                            Text="{Binding Key}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox
                                        Height="200"
                                        Text="{Binding Key, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Body"
                                                Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock
                                            Height="200"
                                            Text="{Binding Value}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox
                                        Height="200"
                                        AcceptsReturn="True"
                                        HorizontalScrollBarVisibility="Auto"
                                        VerticalScrollBarVisibility="Auto"
                                        Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>

                        </DataGridTemplateColumn>
                    </DataGrid.Columns>


                </DataGrid>


                <Border
                    Visibility="{Binding Model.ShowNotFromBodysVisibility}"
                    Grid.Row="7"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                    CornerRadius="5"
                    Margin="5">
                    <TextBox Height="150" Style="{x:Null}"
                             Margin="5"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                             BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                             BorderThickness="0"
                             AcceptsReturn="True"
                             FontSize="15"
                             Text="{Binding Model.HttpBody ,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" />
                </Border>
            </Grid>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="输入" Margin="5" />
            <operationDataGrid:PknOperationDataGrid Grid.Row="1"
                                                    Height="200"
                                                    Node="{Binding}"
                                                    NeedItemSource="{Binding InputParams , Mode=TwoWay }" />
            <TextBlock Grid.Row="2" Text="输出" Margin="5" />
            <operationDataGrid:PknOperationDataGrid Grid.Row="3"
                                                    Height="200"
                                                    Node="{Binding}"
                                                    NeedItemSource="{Binding OutputParams ,Mode=TwoWay}" />
        </Grid>
    </Grid>

</UserControl>